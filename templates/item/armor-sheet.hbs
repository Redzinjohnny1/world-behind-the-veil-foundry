<form class="{{cssClass}} twbv-item-sheet twbv-armor-sheet" autocomplete="off">
  <header class="sheet-header twbv-armor-header">
    <img class="profile-img twbv-armor-profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" height="140" width="140"/>
    <div class="header-fields">
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Nome da Armadura"/></h1>
      <div class="twbv-grid twbv-grid-3col">
        <label>Proteção<input type="text" name="system.protection" value="{{system.protection}}" placeholder="0" /></label>
        <label>Penalidade<input type="text" name="system.penalty" value="{{system.penalty}}" placeholder="0" /></label>
        <input type="hidden" name="system.equipSlot" value="{{system.equipSlot}}" />
      </div>
      <div class="twbv-armor-slot-group">
        <span class="twbv-armor-slot-title">Slot de Equipamento</span>
        <div class="twbv-armor-slot-options">
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="head" {{#ifEquals system.equipSlot "head"}}checked{{/ifEquals}} /><span>Cabeça</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="chest" {{#ifEquals system.equipSlot "chest"}}checked{{/ifEquals}} /><span>Peito</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="legs" {{#ifEquals system.equipSlot "legs"}}checked{{/ifEquals}} /><span>Pernas</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="gloves" {{#ifEquals system.equipSlot "gloves"}}checked{{/ifEquals}} /><span>Luva</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="belt" {{#ifEquals system.equipSlot "belt"}}checked{{/ifEquals}} /><span>Cinto</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="ringLeft" {{#ifEquals system.equipSlot "ringLeft"}}checked{{/ifEquals}} /><span>Anel Esq.</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="ringRight" {{#ifEquals system.equipSlot "ringRight"}}checked{{/ifEquals}} /><span>Anel Dir.</span></label>
        </div>
      </div>
      <div class="twbv-grid twbv-grid-3col">
        <label>Quantidade<input type="number" name="system.quantity" value="{{system.quantity}}" min="0" step="1" /></label>
        <label>Peso<input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1" /></label>
        <label>Custo<input type="number" name="system.cost" value="{{system.cost}}" min="0" step="1" /></label>
      </div>
      <input type="hidden" name="system.equipStatus" value="{{#if system.equipped}}1{{else}}0{{/if}}" />
      <label class="checkbox"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> Equipado</label>
    </div>
  </header>
  <nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="general">Geral</a><a class="item" data-tab="mods">Modificações</a><a class="item" data-tab="description">Descrição</a></nav>
  <section class="sheet-body">
    <div class="tab" data-group="primary" data-tab="general"></div>
    <div class="tab" data-group="primary" data-tab="mods"><header class="mods-header"><h3>Modificações</h3><a class="mod-create"><i class="fas fa-plus"></i> Adicionar Mod</a></header><div class="mods-list">{{#each system.actions.additional as |mod key|}}<div class="mod-row" data-mod-key="{{key}}"><input type="text" name="system.actions.additional.{{key}}.name" value="{{mod.name}}" placeholder="Nome" /><input type="text" name="system.actions.additional.{{key}}.modifier" value="{{mod.modifier}}" placeholder="+1 / -1" /><a class="mod-delete"><i class="fas fa-trash"></i></a></div>{{/each}}</div></div>
    <div class="tab" data-group="primary" data-tab="description"><label>Descrição<textarea name="system.description" rows="8">{{system.description}}</textarea></label></div>
  </section>
  
</form>
