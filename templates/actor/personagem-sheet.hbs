            </section>

          <section class="equipment-section ammunitions">
            <div class="equipment-section-title"><h3>Muni&ccedil;&otilde;es</h3><a class="item-create" data-type="municao"><i class="fas fa-plus"></i> Muni&ccedil;&atilde;o</a></div>
            <div class="equipment-grid">
              {{#each equipment.ammunitions as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section consumables">
            <div class="equipment-section-title"><h3>Consum&iacute;veis</h3><a class="item-create" data-type="consumable"><i class="fas fa-plus"></i> Consum&iacute;vel</a></div>
            <div class="equipment-grid">
              {{#each equipment.consumables as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section others">
            <div class="equipment-section-title"><h3>Outros</h3><a class="item-create" data-type="modificacao"><i class="fas fa-plus"></i> Modifica&ccedil;&atilde;o</a></div>
            <div class="equipment-grid">
              {{#each equipment.others as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>
          </div>
        </section>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="poderes">
      <div class="twbv-panel twbv-ornate twbv-traits-page twbv-powers-page">
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--power">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Poderes</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--power" data-type="poder" data-label="Poder" data-dialog-version="2"><i class="fas fa-plus"></i> Poder</button></div></div>
          <div class="twbv-item-card-list">
            {{#each poderes as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-wand-magic-sparkles"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="poder"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">{{#if item.skill}}Per&iacute;cia: {{item.skill}}{{else}}Per&iacute;cia: -{{/if}} &middot; Mana: {{item.manaCost}}{{#if item.damage}} &middot; Dano: {{item.damage}}{{/if}}{{#if item.areaEffectLabel}} &middot; &Aacute;rea: {{item.areaEffectLabel}}{{/if}}{{#if item.categoria}} &middot; Categoria: {{item.categoria}}{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descri&ccedil;&atilde;o.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{else}}<p class="twbv-adv-empty twbv-trait-empty">Nenhum poder cadastrado.</p>{{/each}}
          </div>
        </div>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="historia">
      <section class="twbv-panel twbv-ornate twbv-history-page">
        <div class="twbv-history-tabs">
          <label><input type="radio" name="twbv-history-view" value="antecedente" checked /><span><i class="fas fa-id-card"></i> Dossi&ecirc;</span></label>
          <label><input type="radio" name="twbv-history-view" value="album" /><span><i class="fas fa-images"></i> &Aacute;lbum</span></label>
        </div>

        <div class="twbv-history-pane twbv-history-pane--antecedente">
          <div class="twbv-history-paper">
            <header class="twbv-history-dossier-title">
              <span>Arquivo pessoal</span>
              <strong>{{actor.name}}</strong>
            </header>

            <div class="twbv-history-dossier-grid">
              <label>Idade
                <input type="text" name="system.historia.antecedente.idade" value="{{system.historia.antecedente.idade}}" placeholder="Ex.: 29" />
              </label>
              <label>G&ecirc;nero / pronomes
                <input type="text" name="system.historia.antecedente.genero" value="{{system.historia.antecedente.genero}}" placeholder="Ex.: ela/dela" />
              </label>
              <label>Altura
                <input type="text" name="system.historia.antecedente.altura" value="{{system.historia.antecedente.altura}}" placeholder="Ex.: 1,72 m" />
              </label>
              <label>Olhos
                <input type="text" name="system.historia.antecedente.olhos" value="{{system.historia.antecedente.olhos}}" placeholder="Cor, brilho, detalhe" />
              </label>
              <label>Cabelo
                <input type="text" name="system.historia.antecedente.cabelo" value="{{system.historia.antecedente.cabelo}}" placeholder="Cor, corte, textura" />
              </label>
              <label>Ocupa&ccedil;&atilde;o
                <input type="text" name="system.historia.antecedente.ocupacao" value="{{system.historia.antecedente.ocupacao}}" placeholder="Trabalho, fun&ccedil;&atilde;o, fachada" />
              </label>
              <label>Resid&ecirc;ncia
                <input type="text" name="system.historia.antecedente.residencia" value="{{system.historia.antecedente.residencia}}" placeholder="Cidade, bairro, ref&uacute;gio" />
              </label>
              <label>Afilia&ccedil;&atilde;o
                <input type="text" name="system.historia.antecedente.afiliacao" value="{{system.historia.antecedente.afiliacao}}" placeholder="Ordem, grupo, patrono" />
              </label>
            </div>

            <div class="twbv-history-row">
              <label>Apar&ecirc;ncia
                <textarea name="system.historia.antecedente.aparencia" rows="5" placeholder="Tra&ccedil;os marcantes, postura, voz, roupas, presen&ccedil;a...">{{system.historia.antecedente.aparencia}}</textarea>
              </label>
              <label>Objetivos
                <textarea name="system.historia.antecedente.objetivos" rows="5" placeholder="Desejos imediatos, ambi&ccedil;&atilde;o central, o que ela n&atilde;o aceita perder...">{{system.historia.antecedente.objetivos}}</textarea>
              </label>
            </div>
            <div class="twbv-history-row twbv-history-row--notes">
              <label>Marcas e peculiaridades
                <textarea name="system.historia.antecedente.marcas" rows="4" placeholder="Cicatrizes, manias, assinatura visual, medo, v&iacute;cio, press&aacute;gio...">{{system.historia.antecedente.marcas}}</textarea>
              </label>
              <label>Rela&ccedil;&otilde;es e segredos
                <textarea name="system.historia.antecedente.relacoes" rows="4" placeholder="Aliados, rivais, d&iacute;vidas, fam&iacute;lia, segredo perigoso...">{{system.historia.antecedente.relacoes}}</textarea>
              </label>
            </div>
            <label class="twbv-history-bio">Biografia
              <textarea name="system.historia.antecedente.biografia" rows="7" placeholder="Origem, virada da vida, como atravessou o V&eacute;u, perdas, escolhas e consequ&ecirc;ncias...">{{system.historia.antecedente.biografia}}</textarea>
            </label>
          </div>
        </div>

        <div class="twbv-history-pane twbv-history-pane--album">
          <header class="twbv-album-header">
            <h2>&Aacute;lbum</h2>
            <div class="twbv-album-header-actions">
              <button type="button" class="twbv-album-section-add"><i class="fas fa-folder-plus"></i> Divis&oacute;ria</button>
              <button type="button" class="twbv-album-add"><i class="fas fa-plus"></i> Foto</button>
            </div>
          </header>
          <div class="twbv-album-sections">
            {{#each albumSections as |section|}}
              <section class="twbv-album-section {{#if section.unfiled}}is-unfiled{{/if}}" data-section-id="{{section.id}}">
                <header class="twbv-album-section-title">
                  <div>
                    <span>{{section.kicker}}</span>
                    <h3>{{section.name}}</h3>
                  </div>
                  <div class="twbv-album-section-actions">
                    <button type="button" class="twbv-album-add-section-photo" data-section-id="{{section.id}}" title="Adicionar foto nesta divis&oacute;ria"><i class="fas fa-plus"></i><span>Foto</span></button>
                    {{#unless section.unfiled}}
                      <button type="button" class="twbv-album-section-rename" data-section-id="{{section.id}}" title="Renomear divis&oacute;ria"><i class="fas fa-pen"></i></button>
                      <button type="button" class="twbv-album-section-remove" data-section-id="{{section.id}}" title="Remover divis&oacute;ria"><i class="fas fa-trash"></i></button>
                    {{/unless}}
                  </div>
                </header>
                <div class="twbv-album-grid" data-section-drop="{{section.id}}">
                  {{#each section.photos as |photo|}}
                    <article class="twbv-album-card" data-index="{{photo.sourceIndex}}" data-section-id="{{section.id}}" draggable="true">
                      <div class="twbv-album-card-actions">
                        <button type="button" class="twbv-album-chat" data-index="{{photo.sourceIndex}}" title="Enviar para o chat"><i class="fas fa-comment"></i></button>
                        <button type="button" class="twbv-album-remove" data-index="{{photo.sourceIndex}}" title="Remover foto"><i class="fas fa-trash"></i></button>
                      </div>
                      <button type="button" class="twbv-album-pick" data-index="{{photo.sourceIndex}}" title="Escolher imagem">
                        {{#if photo.image}}
                          <img src="{{photo.image}}" alt="Foto {{photo.sourceIndex}}" />
                        {{else}}
                          <span><i class="fas fa-image"></i></span>
                        {{/if}}
                      </button>
                      <textarea name="system.historia.album.{{photo.sourceIndex}}.nota" rows="5" placeholder="Nome, cidade, pista, lembran&ccedil;a...">{{photo.nota}}</textarea>
                      <input type="hidden" name="system.historia.album.{{photo.sourceIndex}}.image" value="{{photo.image}}" />
                      <input type="hidden" name="system.historia.album.{{photo.sourceIndex}}.sectionId" value="{{photo.sectionId}}" />
                    </article>
                  {{else}}
                    <p class="twbv-album-empty">Arraste fotos para esta divis&oacute;ria.</p>
                  {{/each}}
                </div>
              </section>
            {{/each}}
          </div>
        </div>
      </section>
    </div>
    <div class="tab" data-group="primary" data-tab="avancos">
      <section class="twbv-panel twbv-ornate twbv-adv-page">
        <div class="twbv-adv-header">
          <h2>Avan&ccedil;os</h2>
          <button type="button" class="twbv-add-advancement"><i class="fas fa-plus"></i> Avan&ccedil;o</button>
        </div>
        <div class="twbv-adv-topline">
          <label>Avan&ccedil;os totais
            <input type="number" name="system.avancosTotais" value="{{system.avancosTotais}}" min="0" />
          </label>
          <label>Est&aacute;gio atual
            <input type="text" value="{{stageName}}" disabled />
          </label>
        </div>
        <div class="twbv-adv-stage-strip">
          {{#each stages as |stage|}}
            <div class="twbv-stage-chip {{#if stage.current}}is-current{{/if}}">
              <span class="twbv-stage-name">{{stage.name}}</span>
              <span class="twbv-stage-range">{{stage.range}}</span>
            </div>
          {{/each}}
        </div>
        <div class="twbv-adv-list">
          {{#if system.avancos.length}}
            {{#each advancementGroups as |group|}}
              <section class="twbv-adv-tier-group {{#if group.current}}is-current{{/if}}" data-tier="{{group.key}}">
                <header class="twbv-adv-tier-header">
                  <span class="twbv-adv-tier-badge">{{group.name}}</span>
                  <span class="twbv-adv-tier-count">{{group.entries.length}} avan&ccedil;o(s)</span>
                </header>
                <div class="twbv-adv-tier-cards">
                  {{#each group.entries as |avanco|}}
                    <details class="twbv-adv-entry">
                      <summary class="twbv-adv-entry-summary">
                        <span class="twbv-adv-entry-number">Avan&ccedil;o {{avanco.numero}}</span>
                        <span class="twbv-adv-entry-title">{{avanco.resumo}}</span>
                        <button type="button" class="twbv-edit-advancement" data-index="{{avanco.sourceIndex}}" title="Editar avan&ccedil;o"><i class="fas fa-edit"></i></button>
                        <button type="button" class="twbv-remove-advancement" data-index="{{avanco.sourceIndex}}" title="Remover avan&ccedil;o"><i class="fas fa-trash"></i></button>
                      </summary>
                      {{#if avanco.descricao}}
                        <p class="twbv-adv-entry-description">{{avanco.descricao}}</p>
                      {{/if}}
                    </details>
                  {{/each}}
                </div>
              </section>
            {{/each}}
          {{else}}
            <p class="twbv-adv-empty">Nenhum avan&ccedil;o registrado ainda.</p>
          {{/if}}
        </div>
      </section>
    </div>
    <div class="tab" data-group="primary" data-tab="efeitos">
      <div class="twbv-panel twbv-ornate twbv-effects-workbench">
        <header class="twbv-effects-hero">
          <div>
            <span class="twbv-effects-kicker">Active Effects</span>
            <h2>Efeitos globais</h2>
          </div>
          <i class="fas fa-wand-sparkles"></i>
        </header>

        <section class="twbv-effect-composer">
          <div class="twbv-effect-kind-grid" role="group" aria-label="Tipo de efeito">
            <button type="button" class="twbv-effect-kind is-active" data-effect-kind="Atributos"><i class="fas fa-dumbbell"></i><span>Atributos</span></button>
            <button type="button" class="twbv-effect-kind" data-effect-kind="Defesas e recursos"><i class="fas fa-shield-alt"></i><span>Defesas</span></button>
            <button type="button" class="twbv-effect-kind" data-effect-kind="Dano"><i class="fas fa-burst"></i><span>Dano</span></button>
            <button type="button" class="twbv-effect-kind" data-effect-kind="Pericias"><i class="fas fa-dice-d20"></i><span>Per&iacute;cias</span></button>
            <button type="button" class="twbv-effect-kind" data-effect-kind="__custom"><i class="fas fa-code"></i><span>Custom</span></button>
          </div>
          <label class="twbv-effect-icon-field">&Iacute;cone
            <span class="twbv-effect-icon-control">
              <button type="button" class="twbv-effect-icon-pick" title="Escolher &iacute;cone">
                <img src="icons/svg/aura.svg" alt="&Iacute;cone do efeito" data-effect-icon-preview />
              </button>
              <input type="text" name="twbvEffectIcon" value="icons/svg/aura.svg" />
            </span>
          </label>
          <label>Nome
            <input type="text" name="twbvEffectName" placeholder="Ex.: Ben&ccedil;&atilde;o de Intui&ccedil;&atilde;o" />
          </label>
          <label>Campo afetado
            <select name="twbvEffectTarget">
              {{#each effectTargetOptions as |option|}}
                <option value="{{option.key}}" data-effect-option-group="{{option.group}}">{{option.label}}</option>
              {{/each}}
              <option value="__custom">Caminho customizado</option>
            </select>
          </label>
          <label class="twbv-effect-custom-path" hidden>Caminho
            <input type="text" name="twbvEffectCustomPath" placeholder="system.atributos.intuicao.bonus" />
          </label>
          <label>Modo
            <select name="twbvEffectMode">
              {{#each effectModeOptions as |option|}}
                <option value="{{option.value}}">{{option.label}}</option>
              {{/each}}
            </select>
          </label>
          <label>Valor
            <input type="text" name="twbvEffectValue" value="1" />
          </label>
          <label>Dura&ccedil;&atilde;o
            <select name="twbvEffectDuration">
              <option value="permanent">Permanente</option>
              <option value="temporary">Tempor&aacute;rio</option>
            </select>
          </label>
          <label class="twbv-effect-rounds" hidden>Rodadas
            <input type="number" name="twbvEffectRounds" value="5" min="1" step="1" />
          </label>
          <label class="twbv-effect-description">Descri&ccedil;&atilde;o
            <input type="text" name="twbvEffectDescription" placeholder="Resumo opcional para lembrar o que este efeito faz" />
          </label>
          <button type="button" class="twbv-effect-quick-add"><i class="fas fa-plus"></i> Adicionar efeito</button>
        </section>

        <section class="twbv-effect-sections">
          <article class="twbv-effect-section">
            <header><i class="fas fa-hourglass-half"></i><span>Tempor&aacute;rios</span></header>
            <ol class="twbv-active-effect-list">
              {{#each sheetEffects.temporary as |effect|}}
                <li class="twbv-active-effect" data-effect-id="{{effect.id}}">
                  <details>
                    <summary>
                      <img src="{{effect.img}}" alt="{{effect.name}}" />
                      <strong>{{effect.name}}</strong>
                      <span>{{effect.durationLabel}}</span>
                      <div class="twbv-effect-controls">
                        <button type="button" class="twbv-effect-action" data-action="toggle" title="Ativar/desativar"><i class="fas fa-power-off"></i></button>
                        <button type="button" class="twbv-effect-action" data-action="edit" title="Editar"><i class="fas fa-edit"></i></button>
                        <button type="button" class="twbv-effect-action" data-action="delete" title="Apagar"><i class="fas fa-trash"></i></button>
                      </div>
                    </summary>
                    <div class="twbv-effect-change-list">
                      {{#each effect.changes as |change|}}
                        <p><b>{{change.label}}</b><span>{{change.modeLabel}} {{change.value}}</span></p>
                      {{/each}}
                      {{#if effect.description}}<em>{{effect.description}}</em>{{/if}}
                    </div>
                  </details>
                </li>
              {{else}}
                <li class="twbv-effect-empty">Nenhum efeito tempor&aacute;rio ativo.</li>
              {{/each}}
            </ol>
          </article>

          <article class="twbv-effect-section">
            <header><i class="fas fa-infinity"></i><span>Permanentes</span></header>
            <ol class="twbv-active-effect-list">
              {{#each sheetEffects.permanent as |effect|}}
                <li class="twbv-active-effect" data-effect-id="{{effect.id}}">
                  <details>
                    <summary>
                      <img src="{{effect.img}}" alt="{{effect.name}}" />
                      <strong>{{effect.name}}</strong>
                      <span>Ativo</span>
                      <div class="twbv-effect-controls">
                        <button type="button" class="twbv-effect-action" data-action="toggle" title="Ativar/desativar"><i class="fas fa-power-off"></i></button>
                        <button type="button" class="twbv-effect-action" data-action="edit" title="Editar"><i class="fas fa-edit"></i></button>
                        <button type="button" class="twbv-effect-action" data-action="delete" title="Apagar"><i class="fas fa-trash"></i></button>
                      </div>
                    </summary>
                    <div class="twbv-effect-change-list">
                      {{#each effect.changes as |change|}}
                        <p><b>{{change.label}}</b><span>{{change.modeLabel}} {{change.value}}</span></p>
                      {{/each}}
                      {{#if effect.description}}<em>{{effect.description}}</em>{{/if}}
                    </div>
                  </details>
                </li>
              {{else}}
                <li class="twbv-effect-empty">Nenhum efeito permanente ativo.</li>
              {{/each}}
            </ol>
          </article>

          <article class="twbv-effect-section">
            <header><i class="fas fa-power-off"></i><span>Inativos</span></header>
            <ol class="twbv-active-effect-list">
              {{#each sheetEffects.inactive as |effect|}}
                <li class="twbv-active-effect is-disabled" data-effect-id="{{effect.id}}">
                  <details>
                    <summary>
                      <img src="{{effect.img}}" alt="{{effect.name}}" />
                      <strong>{{effect.name}}</strong>
                      <span>Desativado</span>
                      <div class="twbv-effect-controls">
                        <button type="button" class="twbv-effect-action" data-action="toggle" title="Ativar/desativar"><i class="fas fa-power-off"></i></button>
                        <button type="button" class="twbv-effect-action" data-action="edit" title="Editar"><i class="fas fa-edit"></i></button>
                        <button type="button" class="twbv-effect-action" data-action="delete" title="Apagar"><i class="fas fa-trash"></i></button>
                      </div>
                    </summary>
                    <div class="twbv-effect-change-list">
                      {{#each effect.changes as |change|}}
                        <p><b>{{change.label}}</b><span>{{change.modeLabel}} {{change.value}}</span></p>
                      {{/each}}
                      {{#if effect.description}}<em>{{effect.description}}</em>{{/if}}
                    </div>
                  </details>
                </li>
              {{else}}
                <li class="twbv-effect-empty">Nenhum efeito inativo.</li>
              {{/each}}
            </ol>
          </article>
        </section>
      </div>
    </div>
  </section>
</form>
