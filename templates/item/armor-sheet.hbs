<form class="{{cssClass}} twbv-item-sheet twbv-themed-item-sheet twbv-elegant-item-sheet twbv-armor-sheet" autocomplete="off">
  <header class="twbv-item-hero">
    <div class="twbv-item-icon-wrap">
      <img class="profile-img twbv-item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    </div>
    <div class="twbv-item-title-block">
      <span class="twbv-item-kicker">Armadura</span>
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Nome da armadura" /></h1>
      <div class="twbv-item-meta-grid">
        <label>Categoria<input type="text" name="system.category" value="{{system.category}}" placeholder="Categoria" /></label>
        <label>Fonte<input type="text" name="system.source" value="{{system.source}}" placeholder="Origem" /></label>
      </div>
    </div>
  </header>

  <section class="twbv-item-summary">
    <article><span>Proteção</span><strong>{{#if system.protection}}{{system.protection}}{{else}}0{{/if}}</strong></article>
    <article><span>Penalidade</span><strong>{{#if system.penalty}}{{system.penalty}}{{else}}0{{/if}}</strong></article>
    <article><span>Peso</span><strong>{{system.weight}}</strong></article>
    <article><span>Custo</span><strong>{{system.cost}}</strong></article>
  </section>

  <nav class="sheet-tabs tabs twbv-item-tabs" data-group="primary">
    <a class="item" data-tab="general">Geral</a>
    <a class="item" data-tab="mods">Modificações</a>
    <a class="item" data-tab="description">Descrição</a>
  </nav>

  <section class="sheet-body twbv-item-body">
    <div class="tab twbv-item-panel" data-group="primary" data-tab="general">
      <h2>Defesa e Encaixe</h2>
      <div class="twbv-item-grid">
        <label>Proteção<input type="text" name="system.protection" value="{{system.protection}}" placeholder="0" /></label>
        <label>Penalidade<input type="text" name="system.penalty" value="{{system.penalty}}" placeholder="0" /></label>
        <label>Quantidade<input type="number" name="system.quantity" value="{{system.quantity}}" min="0" step="1" /></label>
        <label>Peso<input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1" /></label>
        <label>Custo<input type="number" name="system.cost" value="{{system.cost}}" min="0" step="1" /></label>
        <label class="twbv-item-check"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> Equipado</label>
      </div>

      <input type="hidden" name="system.equipStatus" value="{{#if system.equipped}}1{{else}}0{{/if}}" />
      <input type="hidden" name="system.equipSlot" value="{{system.equipSlot}}" />
      <div class="twbv-armor-slot-group twbv-item-slot-group">
        <span class="twbv-armor-slot-title">Slot de Equipamento</span>
        <div class="twbv-armor-slot-options">
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="head" {{#ifEquals system.equipSlot "head"}}checked{{/ifEquals}} /><span>Cabeça</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="chest" {{#ifEquals system.equipSlot "chest"}}checked{{/ifEquals}} /><span>Peito</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="legs" {{#ifEquals system.equipSlot "legs"}}checked{{/ifEquals}} /><span>Pernas</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="boots" {{#ifEquals system.equipSlot "boots"}}checked{{/ifEquals}} /><span>Botas</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="gloves" {{#ifEquals system.equipSlot "gloves"}}checked{{/ifEquals}} /><span>Luva</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="belt" {{#ifEquals system.equipSlot "belt"}}checked{{/ifEquals}} /><span>Cinto</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="ringLeft" {{#ifEquals system.equipSlot "ringLeft"}}checked{{/ifEquals}} /><span>Anel Esq.</span></label>
          <label class="twbv-armor-slot-option"><input type="radio" name="twbv-slot-radio" class="twbv-armor-slot-check" value="ringRight" {{#ifEquals system.equipSlot "ringRight"}}checked{{/ifEquals}} /><span>Anel Dir.</span></label>
        </div>
      </div>
    </div>

    <div class="tab twbv-item-panel" data-group="primary" data-tab="mods">
      <header class="twbv-item-section-head">
        <h2>Modificações</h2>
        <a class="mod-create twbv-item-action"><i class="fas fa-plus"></i> Adicionar Mod</a>
      </header>
      <div class="mods-list twbv-item-mod-list">
        {{#each system.actions.additional as |mod key|}}
        <div class="mod-row twbv-item-mod-row" data-mod-key="{{key}}">
          <input type="text" name="system.actions.additional.{{key}}.name" value="{{mod.name}}" placeholder="Nome" />
          <input type="text" name="system.actions.additional.{{key}}.modifier" value="{{mod.modifier}}" placeholder="+1 / -1" />
          <a class="mod-delete twbv-item-icon-action"><i class="fas fa-trash"></i></a>
        </div>
        {{/each}}
      </div>
    </div>

    <div class="tab twbv-item-panel" data-group="primary" data-tab="description">
      <h2>Descrição</h2>
      <label class="twbv-item-description">{{editor system.description target="system.description" button=true owner=owner editable=editable}}</label>
      <label class="twbv-item-notes">Notas<textarea name="system.notes" rows="6">{{system.notes}}</textarea></label>
    </div>
  </section>
</form>
