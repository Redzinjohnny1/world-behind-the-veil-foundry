<form class="twbv-sheet {{cssClass}}" autocomplete="off">
  <header class="twbv-top-frame twbv-ornate">
    <h1 class="twbv-title">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do Personagem" />
    </h1>

    <div class="twbv-header-layout">
      <section class="twbv-header-portrait twbv-panel twbv-ornate">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </section>

      <section class="twbv-header-identity twbv-panel twbv-ornate">
                <label>Codinome
          <input type="text" name="system.codinome" value="{{system.codinome}}" placeholder="Codinome" />
        </label>
        <label>Conceito
          <input type="text" name="system.conceito" value="{{system.conceito}}" />
        </label>
        <label>Naturalidade / Nacionalidade
          <input type="text" name="system.origem" value="{{system.origem}}" />
        </label>
        <label>Tier Atual
          <input type="text" value="{{stageName}}" disabled />
        </label>
        <label>Avanço
          <input type="number" value="{{system.avancosTotais}}" disabled />
        </label>
        <div class="twbv-header-status-row">
          <label class="twbv-header-status ferimentos-nivel-{{system.ferimentos}} {{conditionStateClass}}" style="{{conditionStateStyle}}">Status Atual
            <input type="text" value="{{condicaoAtual}}" disabled />
          </label>
          <div class="twbv-header-status-gif ferimentos-nivel-{{system.ferimentos}}" aria-hidden="true"></div>
        </div>
      </section>

      <section class="twbv-header-resources">
        <section class="twbv-panel twbv-ornate twbv-eco-panel resource-panel">
          <h2 class="twbv-eco-spend-trigger" role="button" tabindex="0" aria-label="Gastar 1 Eco">Eco</h2>
          <div class="twbv-eco-controls">
            <button type="button" class="twbv-eco-adjust twbv-eco-adjust--minus" data-adjust="-1" aria-label="Reduzir Eco">-</button>
            <div class="twbv-eco-core twbv-eco-spend-trigger" role="button" tabindex="0" aria-label="Gastar 1 Eco">
              <input type="number" name="system.eco" value="{{system.eco}}" min="0" aria-label="Valor de Eco" />
            </div>
            <button type="button" class="twbv-eco-adjust twbv-eco-adjust--plus" data-adjust="1" aria-label="Aumentar Eco">+</button>
          </div>
        </section>

        <section class="twbv-panel twbv-ornate mana-panel resource-panel">
          <h2 class="twbv-mana-trigger" role="button" tabindex="0" aria-label="Gastar 1 Mana">MANA</h2>
          <div class="twbv-mana-controls">
            <button type="button" class="mana-control mana-control--minus" data-adjust="-1" aria-label="Reduzir Mana">-</button>
            <div class="mana-orb">
              <input class="mana-value" type="number" name="system.mana.value" value="{{system.mana.value}}" min="0" aria-label="Valor de Mana" />
            </div>
            <button type="button" class="mana-control mana-control--plus" data-adjust="1" aria-label="Aumentar Mana">+</button>
          </div>
        </section>
      </section>
    </div>
  </header>

  <nav class="sheet-tabs tabs twbv-tabs" data-group="primary">
    <a class="item" data-tab="principal">Principal</a>
    <a class="item" data-tab="vantagens">Vantagens</a>
    <a class="item" data-tab="desvantagens">Desvantagens</a>
    <a class="item" data-tab="equipamento">Equipamento</a>
    <a class="item" data-tab="poderes">Poderes</a>
    <a class="item" data-tab="historia">História</a>
    <a class="item" data-tab="avancos">Avanços</a>
    <a class="item" data-tab="efeitos">Efeitos</a>
  </nav>

  <section class="sheet-body twbv-tab-content">
    <div class="tab" data-group="primary" data-tab="principal">
      <div class="twbv-principal-grid twbv-principal-main">
        <section class="twbv-panel twbv-ornate twbv-attributes-panel">
          <div class="attributes-art-grid" role="group" aria-label="Atributos">
              <section class="twbv-attribute-card"><h3 class="twbv-attr-forca">Força</h3><label>Dado<select name="system.atributos.forca.passo">{{#select system.atributos.forca.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="forca" title="Rolar Força">🎲</button></section>
              <section class="twbv-attribute-card"><h3 class="twbv-attr-destreza">Destreza</h3><label>Dado<select name="system.atributos.destreza.passo">{{#select system.atributos.destreza.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="destreza" title="Rolar Destreza">🎲</button></section>
              <section class="twbv-attribute-card"><h3 class="twbv-attr-constituicao">Constituição</h3><label>Dado<select name="system.atributos.constituicao.passo">{{#select system.atributos.constituicao.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="constituicao" title="Rolar Constituição">🎲</button></section>
              <section class="twbv-attribute-card"><h3 class="twbv-attr-inteligencia">Inteligência</h3><label>Dado<select name="system.atributos.inteligencia.passo">{{#select system.atributos.inteligencia.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="inteligencia" title="Rolar Inteligência">🎲</button></section>
              <section class="twbv-attribute-card"><h3 class="twbv-attr-influencia">Influência</h3><label>Dado<select name="system.atributos.influencia.passo">{{#select system.atributos.influencia.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="influencia" title="Rolar Influência">🎲</button></section>
              <section class="twbv-attribute-card"><h3 class="twbv-attr-intuicao">Intuição</h3><label>Dado<select name="system.atributos.intuicao.passo">{{#select system.atributos.intuicao.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="intuicao" title="Rolar Intuição">🎲</button></section>
          </div>
        </section>

        <div class="twbv-right-column">
          <section class="twbv-panel twbv-ornate twbv-defense-panel">
            <h2 class="twbv-condition-title twbv-defense-title">Defesa</h2>
            <div class="twbv-defense-grid">
              <article class="twbv-defense-box" data-tooltip="{{defesaApararTooltip}}">
                <h3>Aparar</h3>
                                <input type="number" name="system.defesa.aparar" value="{{system.defesa.aparar}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-tooltip="{{defesaResistenciaTooltip}}">
                <h3>Resistência</h3>
                                <input type="number" name="system.defesa.resistencia" value="{{system.defesa.resistencia}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-tooltip="{{defesaDesviarTooltip}}">
                <h3>Desviar</h3>
                <input type="number" name="system.defesa.desviar" value="{{system.defesa.desviar}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-tooltip="{{defesaResistenciaMagicaTooltip}}">
                <h3>Resistência Mágica</h3>
                <input type="number" name="system.defesa.resistenciaMagica" value="{{system.defesa.resistenciaMagica}}" min="0" />
              </article>
            </div>
            <div class="twbv-size-move-grid">
              <article class="twbv-size-move-box">
                <h3>Tamanho</h3>
                <input type="number" name="system.tamanho" value="{{system.tamanho}}" />
              </article>
              <article class="twbv-size-move-box">
                <h3>Mov.</h3>
                <div class="twbv-mov-row">
                  <div class="twbv-mov-flat-wrap" data-mov-tooltip="{{movimentoTooltip}}">
                    <input type="number" value="{{movimentoTotal}}" disabled />
                  </div>
                  <div class="twbv-move-die-wrap" data-mov-tooltip="{{movimentoDieTooltip}}">
                    <button type="button" class="twbv-move-roll">🎲 {{movimentoDieLabel}}</button>
                  </div>
                </div>
              </article>
            </div>
          </section>

          <section class="twbv-panel twbv-ornate twbv-utility-panel">
            <h2 class="twbv-condition-title">Condições</h2>
            <div class="twbv-condition-board">
              <article class="twbv-condition-meter twbv-condition-meter--wounds ferimentos-nivel-{{system.ferimentos}}">
                <h3>Ferimentos</h3>
                <div class="twbv-condition-controls">
                  <button type="button" class="twbv-condition-adjust" data-path="system.ferimentos" data-min="0" data-max="5" data-adjust="-1" aria-label="Reduzir ferimentos">−</button>
                  <div class="twbv-condition-core">
                    <input type="number" name="system.ferimentos" value="{{system.ferimentos}}" min="0" max="5" />
                    <span>/5</span>
                  </div>
                  <button type="button" class="twbv-condition-adjust" data-path="system.ferimentos" data-min="0" data-max="5" data-adjust="1" aria-label="Aumentar ferimentos">+</button>
                </div>
              </article>

              <article class="twbv-condition-meter twbv-condition-meter--fatigue fadiga-nivel-{{system.fadiga}}">
                <h3>Fadiga</h3>
                <div class="twbv-condition-controls">
                  <button type="button" class="twbv-condition-adjust" data-path="system.fadiga" data-min="0" data-max="4" data-adjust="-1" aria-label="Reduzir fadiga">−</button>
                  <div class="twbv-condition-core">
                    <input type="number" name="system.fadiga" value="{{system.fadiga}}" min="0" max="4" />
                    <span>/4</span>
                  </div>
                  <button type="button" class="twbv-condition-adjust" data-path="system.fadiga" data-min="0" data-max="4" data-adjust="1" aria-label="Aumentar fadiga">+</button>
                </div>
              </article>

              <article class="twbv-condition-checklist">
                <h3>Condições</h3>
                <div class="twbv-condition-checklist-grid">
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao1" {{checked system.condicao1}} />Condição 1</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao2" {{checked system.condicao2}} />Condição 2</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao3" {{checked system.condicao3}} />Condição 3</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao4" {{checked system.condicao4}} />Condição 4</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao5" {{checked system.condicao5}} />Condição 5</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao6" {{checked system.condicao6}} />Condição 6</label>
                </div>
              </article>
            </div>
          </section>
          <section class="twbv-panel twbv-ornate twbv-favorites-panel">
            <h2>Favoritos</h2>
            <div class="twbv-favorites-placeholder">Armas favoritas, magias e outros favoritos.</div>
          </section>
        </div>

        <section class="twbv-panel twbv-ornate">
          <div class="twbv-pericias-header">
            <h2>Perícias</h2>
            <div class="twbv-pericias-actions">
              <button type="button" class="twbv-sort-skills {{#if skillSortActive}}is-active{{/if}}" title="{{#if skillSortActive}}Restaurar ordem anterior{{else}}Ordenar perícias em ordem alfabética{{/if}}"><i class="fas fa-sort-alpha-down"></i></button>
              <button type="button" class="twbv-add-skill" title="Adicionar perícia">+</button>
            </div>
          </div>
          <div class="twbv-skills-grid">
            {{#each system.pericias as |pericia i|}}
              <div class="twbv-skill-row" data-index="{{i}}" draggable="true">
                <button type="button" class="twbv-skill-roll twbv-skill-icon" data-index="{{i}}" title="Rolar perícia {{pericia.nome}}"><img src="{{pericia.attributeMeta.iconPath}}" class="attribute-icon-img" alt="{{pericia.attributeMeta.label}}"></button>
                <button type="button" class="twbv-edit-skill-config" data-index="{{i}}" title="Configurar perícia">
                  <span class="twbv-skill-name">{{pericia.nome}}</span>
                  <span class="twbv-skill-meta">
                    <span class="twbv-skill-attr twbv-attr-{{pericia.atributo}}">{{pericia.attributeMeta.label}}</span>
                    <span class="twbv-skill-rank {{pericia.rank.cssClass}}">{{pericia.rank.label}}</span>
                  </span>
                </button>
                <span class="twbv-skill-die">{{pericia.rollLabel}}</span>
                <button type="button" class="twbv-toggle-skill-lock" data-index="{{i}}" title="{{#if pericia.locked}}Destravar perícia{{else}}Travar perícia{{/if}}"><i class="fas {{#if pericia.locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
                <button type="button" class="twbv-remove-skill" data-index="{{i}}" title="Remover perícia"><i class="fas fa-trash"></i></button>
              </div>
            {{else}}
              <div class="twbv-skills-empty"></div>
            {{/each}}
          </div>
          <section class="twbv-skill-levels-panel">
            <h3 class="twbv-skill-levels-title">NÍVEIS DE PERÍCIA</h3>
            <div class="twbv-skill-levels-grid">
              <article class="twbv-skill-level-card rank-novato"><h4>NOVATO</h4><p>Pouca ou nenhuma experiência na área.</p></article>
              <article class="twbv-skill-level-card rank-treinado"><h4>TREINADO</h4><p>Conhecimento básico e prática constante.</p></article>
              <article class="twbv-skill-level-card rank-experiente"><h4>EXPERIENTE</h4><p>Ampla experiência e confiança.</p></article>
              <article class="twbv-skill-level-card rank-especialista"><h4>ESPECIALISTA</h4><p>Domínio elevado e precisão notável.</p></article>
              <article class="twbv-skill-level-card rank-mestre"><h4>MESTRE</h4><p>Excelência quase lendária.</p></article>
            </div>
          </section>
        </section>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="vantagens">
      <div class="twbv-panel twbv-ornate">
        <div class="twbv-item-section">
          <div class="twbv-item-tab-header"><h2>VANTAGENS</h2><button type="button" class="twbv-item-create twbv-item-create--fancy" data-type="vantagem" data-label="Vantagem"><i class="fas fa-plus"></i> Adicionar vantagem</button></div>
          <div class="twbv-item-card-list">
            {{#each vantagens as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon"><i class="fas fa-gem"></i></div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="system" data-list-key="vantagens" data-type="vantagem"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="system" data-list-key="vantagens"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">Requisito/Tier: {{#if item.requisitos}}{{item.requisitos}}{{else}}-{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descrição.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{else}}<p class="twbv-adv-empty">Nenhuma vantagem cadastrada.</p>{{/each}}
          </div>
        </div>
        <div class="twbv-item-section">
          <div class="twbv-item-tab-header"><h2>HABILIDADES ESPECIAIS</h2><button type="button" class="twbv-item-create twbv-item-create--fancy" data-type="habilidadeEspecial" data-label="Habilidade Especial"><i class="fas fa-plus"></i> Adicionar habilidade especial</button></div>
          <div class="twbv-item-card-list">
            {{#each habilidadesEspeciais as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon"><i class="fas fa-hat-wizard"></i></div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="system" data-list-key="habilidadesEspeciais" data-type="habilidadeEspecial"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="system" data-list-key="habilidadesEspeciais"><i class="fas fa-trash"></i></button></div></div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descrição.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{else}}<p class="twbv-adv-empty">Nenhuma habilidade especial cadastrada.</p>{{/each}}
          </div>
        </div>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="desvantagens">
      <div class="twbv-panel twbv-ornate">
        <div class="twbv-item-section">
        <div class="twbv-item-tab-header"><h2>COMPLICAÇÕES</h2><button type="button" class="twbv-item-create twbv-item-create--fancy" data-type="complicacao" data-label="Complicação"><i class="fas fa-plus"></i> Adicionar complicação</button></div>
        <div class="twbv-item-card-list">
          {{#each complicacoes as |item|}}
            <article class="twbv-item-card twbv-item-card--fantasy">
              <div class="twbv-item-card-layout">
                <div class="twbv-item-card-icon"><i class="fas fa-skull"></i></div>
                <div class="twbv-item-card-content">
                  <div class="twbv-item-card-head"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="system" data-list-key="complicacoes" data-type="complicacao"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="system" data-list-key="complicacoes"><i class="fas fa-trash"></i></button></div></div>
              <div class="twbv-item-card-meta">Categoria: {{#if item.categoria}}{{item.categoria}}{{else}}-{{/if}}</div>
                  <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descrição.{{/if}}</p>
                </div>
              </div>
            </article>
          {{else}}<p class="twbv-adv-empty">Nenhuma complicação cadastrada.</p>{{/each}}
        </div>
        </div>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="equipamento">
      <div class="twbv-panel twbv-ornate">
        <section class="equipment-tab-wrap">
          <header class="equipment-header">
            <h2>Equipamentos</h2>
            <div class="twbv-item-tab-adders">
              <a class="item-create" data-type="weapon"><i class="fas fa-plus"></i> Arma</a>
              <a class="item-create" data-type="consumable"><i class="fas fa-plus"></i> Consumível</a>
            </div>
          </header>

          <section class="equipment-section favorites">
            <h3>Favoritos</h3>
            <div class="equipment-grid">
              {{#each equipment.favorite as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section weapons">
            <h3>Armas</h3>
            <div class="equipment-grid">
              {{#each equipment.weapons as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section magazines">
            <h3>Carregadores</h3>
            <div class="equipment-grid">
              {{#each equipment.magazines as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section consumables">
            <h3>Consumíveis</h3>
            <div class="equipment-grid">
              {{#each equipment.consumables as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section others">
            <h3>Outros</h3>
            <div class="equipment-grid">
              {{#each equipment.others as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>
        </section>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="poderes"><div class="twbv-panel twbv-ornate"><h2>Poderes</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="historia"><div class="twbv-panel twbv-ornate"><h2>História</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="avancos">
      <section class="twbv-panel twbv-ornate">
        <div class="twbv-adv-header">
          <h2>Avanços</h2>
          <button type="button" class="twbv-add-advancement"><i class="fas fa-plus"></i> Adicionar avanço</button>
        </div>
        <label>Avanços totais
          <input type="number" name="system.avancosTotais" value="{{system.avancosTotais}}" min="0" />
        </label>
        <label>Estágio atual
          <input type="text" value="{{stageName}}" disabled />
        </label>
        <div class="twbv-stages-grid">
          {{#each stages as |stage|}}
            <div class="twbv-stage-chip {{#if stage.current}}is-current{{/if}}">
              <span class="twbv-stage-name">{{stage.name}}</span>
              <span class="twbv-stage-range">{{stage.range}}</span>
            </div>
          {{/each}}
        </div>
        <div class="twbv-adv-list">
          {{#if system.avancos.length}}
            {{#each advancementGroups as |group|}}
              <section class="twbv-adv-tier-group" data-tier="{{group.key}}">
                <header class="twbv-adv-tier-header">
                  <span class="twbv-adv-tier-badge">{{group.name}}</span>
                </header>
                <div class="twbv-adv-tier-cards">
                  {{#each group.entries as |avanco|}}
                    <article class="twbv-adv-entry">
                      <button type="button" class="twbv-remove-advancement" data-index="{{avanco.sourceIndex}}" title="Remover avanço"><i class="fas fa-trash"></i></button>
                      <h3>Avanço {{avanco.numero}} — {{#if avanco.tipo}}{{avanco.tipo}}{{else}}Outro{{/if}}</h3>
                      <p class="twbv-adv-entry-description">{{#if avanco.descricao}}{{avanco.descricao}}{{else}}Sem descrição.{{/if}}</p>
                    </article>
                  {{/each}}
                </div>
              </section>
            {{/each}}
          {{else}}
            <p class="twbv-adv-empty">Nenhum avanço registrado ainda.</p>
          {{/if}}
        </div>
      </section>
    </div>
    <div class="tab" data-group="primary" data-tab="efeitos"><div class="twbv-panel twbv-ornate"><h2>Efeitos</h2><p>Em construção.</p></div></div>
  </section>
</form>
