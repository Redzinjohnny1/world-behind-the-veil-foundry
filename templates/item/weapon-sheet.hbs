<form class="{{cssClass}} item-sheet weapon-sheet" autocomplete="off"><header class="sheet-header"><img src="{{item.img}}" data-edit="img" title="{{item.name}}" /><div class="header-fields"><input name="name" type="text" value="{{item.name}}" placeholder="Nome da arma" /><input name="system.category" type="text" value="{{system.category}}" placeholder="Categoria" /></div></header><nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="weapon">Arma</a><a class="item" data-tab="general">Geral</a><a class="item" data-tab="combat">Combate</a><a class="item" data-tab="mods">Modificações</a><a class="item" data-tab="description">Descrição</a></nav><section class="sheet-body">
<div class="tab" data-group="primary" data-tab="weapon"><div class="form-group"><label>Categoria</label><input type="text" name="system.category" value="{{system.category}}" placeholder="Categoria" /></div><div class="form-group"><label>Dano</label><input type="text" name="system.damage" value="{{system.damage}}" /></div><div class="form-group"><label>Alcance</label><input type="text" name="system.range" value="{{system.range}}" /></div><div class="form-group"><label>CdT / ROF</label><input type="number" name="system.rof" value="{{system.rof}}" /></div><div class="form-group"><label>AP</label><input type="number" name="system.ap" value="{{system.ap}}" /></div><div class="form-group"><label>Capacidade</label><input type="number" name="system.shots" value="{{system.shots}}" /></div><div class="form-group"><label>Munição Atual</label><input type="number" name="system.currentShots" value="{{system.currentShots}}" /></div><div class="form-group"><label>Nome do Carregador</label><input type="text" name="system.ammo" value="{{system.ammo}}" /></div><fieldset class="weapon-slots-group"><legend>SLOT DE ARMA</legend><div class="weapon-slots"><label><input type="radio" name="system.weaponSlot" value="lamina_curta" {{#ifEquals system.weaponSlot "lamina_curta"}}checked{{/ifEquals}} /> Lâmina curta</label><label><input type="radio" name="system.weaponSlot" value="lamina_longa" {{#ifEquals system.weaponSlot "lamina_longa"}}checked{{/ifEquals}} /> Lâmina Longa</label><label><input type="radio" name="system.weaponSlot" value="contusao_corpo" {{#ifEquals system.weaponSlot "contusao_corpo"}}checked{{/ifEquals}} /> Contusão/Corpo</label><label><input type="radio" name="system.weaponSlot" value="pistolas" {{#ifEquals system.weaponSlot "pistolas"}}checked{{/ifEquals}} /> Pistolas</label><label><input type="radio" name="system.weaponSlot" value="revolver" {{#ifEquals system.weaponSlot "revolver"}}checked{{/ifEquals}} /> Revolver</label><label><input type="radio" name="system.weaponSlot" value="submetralhadora" {{#ifEquals system.weaponSlot "submetralhadora"}}checked{{/ifEquals}} /> Submetralhadora</label><label><input type="radio" name="system.weaponSlot" value="assalto" {{#ifEquals system.weaponSlot "assalto"}}checked{{/ifEquals}} /> Assalto</label><label><input type="radio" name="system.weaponSlot" value="escopeta" {{#ifEquals system.weaponSlot "escopeta"}}checked{{/ifEquals}} /> Escopeta</label><label><input type="radio" name="system.weaponSlot" value="sniper" {{#ifEquals system.weaponSlot "sniper"}}checked{{/ifEquals}} /> Sniper</label></div></fieldset></div>
<div class="tab" data-group="primary" data-tab="general"><div class="form-group"><label>Quantidade</label><input type="number" name="system.quantity" value="{{system.quantity}}" /></div><div class="form-group"><label>Peso</label><input type="number" step="0.1" name="system.weight" value="{{system.weight}}" /></div><div class="form-group"><label>Preço</label><input type="number" name="system.price" value="{{system.price}}" /></div><div class="form-group"><label>Favorito</label><input type="checkbox" name="system.favorite" {{checked system.favorite}} /></div></div>
<div class="tab" data-group="primary" data-tab="combat"><div class="form-group"><label>Dano</label><input type="text" name="system.damage" value="{{system.damage}}" /></div><div class="form-group"><label>Alcance</label><input type="text" name="system.range" value="{{system.range}}" /></div><div class="form-group"><label>CdT / ROF</label><input type="number" name="system.rof" value="{{system.rof}}" /></div><div class="form-group"><label>AP</label><input type="number" name="system.ap" value="{{system.ap}}" /></div><div class="form-group"><label>Capacidade</label><input type="number" name="system.shots" value="{{system.shots}}" /></div><div class="form-group"><label>Munição Atual</label><input type="number" name="system.currentShots" value="{{system.currentShots}}" /></div><div class="form-group"><label>Nome do Carregador</label><input type="text" name="system.ammo" value="{{system.ammo}}" /></div></div>
<div class="tab" data-group="primary" data-tab="mods"><header class="mods-header"><h3>Modificações</h3><a class="mod-create"><i class="fas fa-plus"></i> Adicionar Mod</a></header><div class="mods-list">{{#each system.actions.additional as |mod key|}}<div class="mod-row" data-mod-key="{{key}}"><input type="text" name="system.actions.additional.{{key}}.name" value="{{mod.name}}" placeholder="Nome" /><select name="system.actions.additional.{{key}}.type"><option value="trait" {{#ifEquals mod.type "trait"}}selected{{/ifEquals}}>Ataque / Perícia</option><option value="damage" {{#ifEquals mod.type "damage"}}selected{{/ifEquals}}>Dano</option></select><input type="text" name="system.actions.additional.{{key}}.modifier" value="{{mod.modifier}}" placeholder="+1 / -1" /><input type="number" name="system.actions.additional.{{key}}.dice" value="{{mod.dice}}" /><a class="mod-delete"><i class="fas fa-trash"></i></a></div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="description"><div class="form-group stacked"><label>Descrição</label>{{editor system.description target="system.description" button=true owner=owner editable=editable}}</div><div class="form-group stacked"><label>Notas</label><textarea name="system.notes">{{system.notes}}</textarea></div></div>
</section><footer class="sheet-footer"><button type="submit" class="twbv-sheet-save">💾 Salvar</button><button type="button" class="twbv-sheet-cancel">✕ Cancelar</button></footer></form>
