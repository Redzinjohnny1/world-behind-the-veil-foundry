<form class="{{cssClass}} item-sheet weapon-sheet twbv-item-sheet twbv-themed-item-sheet" autocomplete="off"><header class="sheet-header twbv-armor-header"><img class="profile-img twbv-armor-profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" /><div class="header-fields"><h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Nome da arma" /></h1><input name="system.category" type="text" value="{{system.category}}" placeholder="Categoria" /></div></header><nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="general">Geral</a><a class="item" data-tab="combat">Combate</a><a class="item" data-tab="mods">Modificações</a><a class="item" data-tab="description">Descrição</a></nav><section class="sheet-body">
<div class="tab" data-group="primary" data-tab="general"><div class="form-group"><label>Quantidade</label><input type="number" name="system.quantity" value="{{system.quantity}}" /></div><div class="form-group"><label>Peso</label><input type="number" step="0.1" name="system.weight" value="{{system.weight}}" /></div><div class="form-group"><label>Preço</label><input type="number" name="system.price" value="{{system.price}}" /></div><div class="form-group"><label>Favorito</label><input type="checkbox" name="system.favorite" {{checked system.favorite}} /></div></div>
<div class="twbv-armor-slot-group"><span class="twbv-armor-slot-title">Slot de Arma</span><div class="twbv-armor-slot-options"><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="shortBlade" {{#ifEquals system.equipSlot "shortBlade"}}checked{{/ifEquals}} /><span>Lâmina curta</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="longBlade" {{#ifEquals system.equipSlot "longBlade"}}checked{{/ifEquals}} /><span>Lâmina Longa</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="blunt" {{#ifEquals system.equipSlot "blunt"}}checked{{/ifEquals}} /><span>Contusivo/Corporal</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="pistol" {{#ifEquals system.equipSlot "pistol"}}checked{{/ifEquals}} /><span>Pistolas</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="revolver" {{#ifEquals system.equipSlot "revolver"}}checked{{/ifEquals}} /><span>Revólver</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="smg" {{#ifEquals system.equipSlot "smg"}}checked{{/ifEquals}} /><span>Submetralhadoras</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="assault" {{#ifEquals system.equipSlot "assault"}}checked{{/ifEquals}} /><span>Assalto</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="shotgun" {{#ifEquals system.equipSlot "shotgun"}}checked{{/ifEquals}} /><span>Escopeta</span></label><label class="twbv-weapon-slot-option"><input type="radio" name="twbv-weapon-slot-radio" class="twbv-weapon-slot-check" value="sniper" {{#ifEquals system.equipSlot "sniper"}}checked{{/ifEquals}} /><span>Sniper</span></label></div></div><input type="hidden" name="system.equipSlot" value="{{system.equipSlot}}" /><input type="hidden" name="system.equipStatus" value="{{#if system.equipped}}1{{else}}0{{/if}}" /><div class="form-group"><label>Equipado</label><input type="checkbox" name="system.equipped" {{checked system.equipped}} /></div>
<div class="tab" data-group="primary" data-tab="combat"><div class="form-group"><label>Dano</label><input type="text" name="system.damage" value="{{system.damage}}" /></div><div class="form-group"><label>Alcance</label><input type="text" name="system.range" value="{{system.range}}" /></div><div class="form-group"><label>CdT / ROF</label><input type="number" name="system.rof" value="{{system.rof}}" /></div><div class="form-group"><label>AP</label><input type="number" name="system.ap" value="{{system.ap}}" /></div><div class="form-group"><label>Capacidade</label><input type="number" name="system.shots" value="{{system.shots}}" /></div><div class="form-group"><label>Munição Atual</label><input type="number" name="system.currentShots" value="{{system.currentShots}}" /></div><div class="form-group"><label>Nome do Carregador</label><input type="text" name="system.ammo" value="{{system.ammo}}" /></div></div>
<div class="tab" data-group="primary" data-tab="mods"><header class="mods-header"><h3>Modificações</h3><a class="mod-create"><i class="fas fa-plus"></i> Adicionar Mod</a></header><div class="mods-list">{{#each system.actions.additional as |mod key|}}<div class="mod-row" data-mod-key="{{key}}"><input type="text" name="system.actions.additional.{{key}}.name" value="{{mod.name}}" placeholder="Nome" /><select name="system.actions.additional.{{key}}.type"><option value="trait" {{#ifEquals mod.type "trait"}}selected{{/ifEquals}}>Ataque / Perícia</option><option value="damage" {{#ifEquals mod.type "damage"}}selected{{/ifEquals}}>Dano</option></select><input type="text" name="system.actions.additional.{{key}}.modifier" value="{{mod.modifier}}" placeholder="+1 / -1" /><input type="number" name="system.actions.additional.{{key}}.dice" value="{{mod.dice}}" /><a class="mod-delete"><i class="fas fa-trash"></i></a></div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="description"><div class="form-group stacked"><label>Descrição</label>{{editor system.description target="system.description" button=true owner=owner editable=editable}}</div><div class="form-group stacked"><label>Notas</label><textarea name="system.notes">{{system.notes}}</textarea></div></div>
</section><footer class="twbv-armor-footer"><button type="submit" class="twbv-sheet-save"><i class="fas fa-save"></i> Salvar</button><button type="button" class="twbv-sheet-cancel"><i class="fas fa-times"></i> Cancelar</button></footer></form>
