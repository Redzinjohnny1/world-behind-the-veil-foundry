<form class="{{cssClass}} item-sheet consumable-sheet" autocomplete="off"><header class="sheet-header"><img src="{{item.img}}" data-edit="img" title="{{item.name}}" /><div class="header-fields"><input name="name" type="text" value="{{item.name}}" placeholder="Nome do consumível" /><input name="system.category" type="text" value="{{system.category}}" placeholder="Categoria" /></div></header><nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="general">Geral</a><a class="item" data-tab="charges">Cargas</a><a class="item" data-tab="description">Descrição</a></nav><section class="sheet-body"><div class="tab" data-group="primary" data-tab="general"><div class="form-group"><label>Quantidade</label><input type="number" name="system.quantity" value="{{system.quantity}}" /></div><div class="form-group"><label>Peso</label><input type="number" step="0.1" name="system.weight" value="{{system.weight}}" /></div><div class="form-group"><label>Preço</label><input type="number" name="system.price" value="{{system.price}}" /></div><div class="form-group"><label>Subtipo</label><input type="text" name="system.subtype" value="{{system.subtype}}" /></div></div><div class="tab" data-group="primary" data-tab="charges"><div class="form-group"><label>Possui Cargas</label><input type="checkbox" name="system.charges.hasCharges" {{checked system.charges.hasCharges}} /></div><div class="form-group"><label>Valor Atual</label><input type="number" name="system.charges.charges.main.value" value="{{system.charges.charges.main.value}}" /></div><div class="form-group"><label>Valor Máximo</label><input type="number" name="system.charges.charges.main.max" value="{{system.charges.charges.main.max}}" /></div></div><div class="tab" data-group="primary" data-tab="description"><div class="form-group stacked"><label>Descrição</label>{{editor system.description target="system.description" button=true owner=owner editable=editable}}</div></div></section><footer class="sheet-footer"><button type="submit" class="twbv-sheet-save">💾 Salvar</button><button type="button" class="twbv-sheet-cancel">✕ Cancelar</button></footer></form>
