<div class="equipment-card twbv-equipment-card item item-type-{{item.type}}" data-item-id="{{item._id}}" data-item-uuid="{{item.uuid}}" draggable="true">
  <div class="equipment-card-header">
    <img class="equipment-img" src="{{item.img}}" title="{{item.name}}" draggable="true" />
    <div class="equipment-title-block">
      <div class="equipment-name">{{item.name}}</div>
      <div class="equipment-category">{{#if item.system.categoryLabel}}{{item.system.categoryLabel}}{{else}}{{item.typeLabel}}{{/if}}</div>
    </div>
    <div class="equipment-actions-top">
      <a class="item-toggle-equip" title="{{#if item.isEquipped}}Desequipar{{else}}Equipar{{/if}}"><i class="fas {{#if item.isEquipped}}fa-link-slash{{else}}fa-link{{/if}}"></i></a>
      <a class="item-toggle-favorite" title="Favorito">{{#if item.system.favorite}}<i class="fas fa-star"></i>{{else}}<i class="far fa-star"></i>{{/if}}</a>
      <a class="item-donate" title="Doar para outra ficha"><i class="fas fa-gift"></i></a>
      <a class="item-sell" title="Vender para outra ficha"><i class="fas fa-handshake"></i></a>
      <a class="item-edit" title="Editar"><i class="fas fa-edit"></i></a>
      <a class="item-delete" title="Excluir"><i class="fas fa-trash"></i></a>
    </div>
  </div>

  {{#if item.equipSlot}}<div class="equipment-slot-label">Slot: {{item.equipSlot}}</div>{{/if}}

  {{#isWeaponType item.type}}
  <div class="equipment-slot-label twbv-weapon-hand-state">
    Empunhadura: {{item.equippedHandLabel}}{{#if item.isEquipped}} &middot; Equipado{{else}} &middot; Guardado{{/if}}
  </div>
  <div class="weapon-stats">
    <span>Dano: {{item.system.damage}}</span>
    <span>AP: {{item.system.ap}}</span>
    <span>Alcance: {{item.system.range}}</span>
    <span>CdT: {{item.system.rof}}</span>
  </div>
  {{#if item.system.skill}}<div class="equipment-slot-label">Per&iacute;cia: {{item.system.skill}}</div>{{/if}}
  <div class="ammo-row"><span>Muni&ccedil;&atilde;o</span><span>{{item.system.currentShots}} / {{item.system.shots}}</span></div>
  <div class="ammo-bar"><div class="ammo-fill" style="width: {{item.system.ammoPercent}}%;"></div></div>
  {{#if item.system.ammo}}<div class="equipment-slot-label">Muni&ccedil;&atilde;o: {{item.system.ammo}}</div>{{/if}}
  <div class="weapon-buttons">
    <a class="item-toggle-equip twbv-equip-command"><i class="fas {{#if item.isEquipped}}fa-link-slash{{else}}fa-link{{/if}}"></i> {{#if item.isEquipped}}Desequipar{{else}}Equipar{{/if}}</a>
    <a class="weapon-roll"><i class="fas fa-dice-d20"></i> Atirar</a>
    <a class="weapon-damage"><i class="fas fa-burst"></i> Dano</a>
    <a class="weapon-reload"><i class="fas fa-rotate"></i> Recarregar</a>
  </div>
  <div class="weapon-mods">{{#each item.system.actions.additional as |mod key|}}<a class="weapon-mod" data-mod-key="{{key}}">{{mod.name}}</a>{{/each}}</div>
  {{/isWeaponType}}

  {{#ifEquals item.type "armadura"}}
  <div class="weapon-stats">
    <span>Prote&ccedil;&atilde;o: {{item.system.protection}}</span>
    <span>Penalidade: {{item.system.penalty}}</span>
    <span>Peso: {{item.system.weight}}</span>
  </div>
  <div class="consumable-buttons"><a class="item-toggle-equip twbv-equip-command"><i class="fas {{#if item.isEquipped}}fa-link-slash{{else}}fa-link{{/if}}"></i> {{#if item.isEquipped}}Desequipar{{else}}Equipar{{/if}}</a></div>
  {{/ifEquals}}

  {{#ifEquals item.type "consumable"}}
  <div class="consumable-stats"><span>Qtd: {{item.system.quantity}}</span><span>Peso: {{item.system.weight}}</span><span>Custo: {{item.system.cost}}</span></div>
  {{#if item.system.charges.hasCharges}}
  <div class="charges-row"><span>Cargas</span><span>{{item.system.mainCharge.value}} / {{item.system.mainCharge.max}}</span></div>
  <div class="ammo-bar"><div class="ammo-fill" style="width: {{item.system.chargePercent}}%;"></div></div>
  {{/if}}
  <div class="consumable-buttons"><a class="consumable-use"><i class="fas fa-hand"></i> Usar</a></div>
  {{/ifEquals}}

  {{#ifEquals item.type "municao"}}
  <div class="consumable-stats">
    <span>Tipo: {{item.system.reloadTypeLabel}}</span>
    <span>Calibre: {{item.system.caliber}}</span>
  </div>
  <div class="ammo-row"><span>Muni&ccedil;&atilde;o</span><span>{{item.system.currentShots}} / {{item.system.shots}}</span></div>
  <div class="ammo-bar"><div class="ammo-fill" style="width: {{item.system.ammoPercent}}%;"></div></div>
  {{#unless item.isAmmoBox}}<div class="consumable-buttons"><a class="ammo-load-carrier"><i class="fas fa-box-open"></i> Carregar</a></div>{{/unless}}
  {{/ifEquals}}

  {{#ifEquals item.type "modificacao"}}
  <div class="consumable-stats"><span>Uso: {{item.system.modType}}</span><span>B&ocirc;nus: {{item.system.modifier}}</span><span>Dano: {{item.system.damage}}</span></div>
  {{/ifEquals}}
</div>
