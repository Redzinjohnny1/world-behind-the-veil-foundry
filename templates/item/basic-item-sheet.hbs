<form class="{{cssClass}} twbv-item-sheet twbv-basic-item-sheet twbv-themed-item-sheet twbv-elegant-item-sheet" autocomplete="off">
  <header class="twbv-item-hero">
    <div class="twbv-item-icon-wrap">
      <img class="profile-img twbv-item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    </div>
    <div class="twbv-item-title-block">
      <span class="twbv-item-kicker">{{typeLabel}}</span>
      <h1 class="charname"><input name="name" type="text" value="{{item.name}}" placeholder="Nome do item" /></h1>
      <div class="twbv-item-meta-grid">
        <label>Categoria<input type="text" name="system.category" value="{{displayCategory}}" placeholder="Categoria" /></label>
        <label>Tags<input type="text" name="system.tags" value="{{system.tags}}" placeholder="tags" /></label>
      </div>
    </div>
  </header>

  <section class="twbv-item-summary">
    <article><span>Quantidade</span><strong>{{system.quantity}}</strong></article>
    <article><span>Peso</span><strong>{{system.weight}}</strong></article>
    <article><span>Custo</span><strong>{{system.cost}}</strong></article>
    <article><span>Status</span><strong>{{#if system.active}}Ativo{{else}}Inativo{{/if}}</strong></article>
  </section>

  <nav class="sheet-tabs tabs twbv-item-tabs" data-group="primary">
    <a class="item" data-tab="general">Geral</a>
    {{#ifEquals item.type "modificacao"}}<a class="item" data-tab="effects">Efeitos</a>{{/ifEquals}}
    <a class="item" data-tab="description">Descrição</a>
  </nav>

  <section class="sheet-body twbv-item-body">
    <div class="tab twbv-item-panel" data-group="primary" data-tab="general">
      <h2>Controle</h2>
      <div class="twbv-item-grid">
        <label>Tipo<input type="text" value="{{typeLabel}}" disabled /></label>
        <label>Quantidade<input type="number" name="system.quantity" value="{{system.quantity}}" min="0" step="1" /></label>
        <label>Peso<input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.1" /></label>
        <label>Custo<input type="number" name="system.cost" value="{{system.cost}}" min="0" step="1" /></label>
        <label class="twbv-item-check"><input type="checkbox" name="system.active" {{checked system.active}} /> Ativo</label>
        <label class="twbv-item-check"><input type="checkbox" name="system.equipped" {{checked system.equipped}} /> Equipado</label>
      </div>
    </div>

    {{#ifEquals item.type "modificacao"}}
    <div class="tab twbv-item-panel" data-group="primary" data-tab="effects">
      <h2>Efeitos da Modificação</h2>
      <div class="twbv-item-grid">
        <label>Uso
          <select name="system.modType">
            <option value="mod" {{#ifEquals system.modType "mod"}}selected{{/ifEquals}}>Modificação</option>
          </select>
        </label>
        <label>Bônus para acertar<input type="text" name="system.modifier" value="{{system.modifier}}" placeholder="+1" /></label>
        <label>Dano extra<input type="text" name="system.damage" value="{{system.damage}}" placeholder="+1d6" /></label>
        <label>AP<input type="number" name="system.ap" value="{{system.ap}}" step="1" /></label>
      </div>
    </div>
    {{/ifEquals}}

    <div class="tab twbv-item-panel" data-group="primary" data-tab="description">
      <h2>Descrição</h2>
      <label class="twbv-item-description">{{editor system.description target="system.description" button=true owner=owner editable=editable}}</label>
      <label class="twbv-item-notes">Resumo de efeitos<textarea name="system.effectsSummary" rows="3">{{system.effectsSummary}}</textarea></label>
    </div>
  </section>
</form>
