<form class="twbv-sheet {{cssClass}} twbv-actor-kind-{{actorKind}}" autocomplete="off">
  <header class="twbv-top-frame twbv-ornate">
    <h1 class="twbv-title">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do Personagem" />
    </h1>

    <div class="twbv-header-layout">
      <section class="twbv-header-portrait twbv-panel twbv-ornate">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </section>

      <section class="twbv-header-identity twbv-panel twbv-ornate">
                <label>Codinome
          <input type="text" name="system.codinome" value="{{system.codinome}}" placeholder="Codinome" />
        </label>
        <label>Conceito
          <input type="text" name="system.conceito" value="{{system.conceito}}" />
        </label>
        <label>Naturalidade / Nacionalidade
          <input type="text" name="system.origem" value="{{system.origem}}" />
        </label>
        <label>Tier Atual
          <input type="text" value="{{stageName}}" disabled />
        </label>
        <label>Avanço
          <input type="number" value="{{system.avancosTotais}}" disabled />
        </label>
        <div class="twbv-header-status-row">
          <label class="twbv-header-status ferimentos-nivel-{{system.ferimentos}} {{conditionStateClass}}" style="{{conditionStateStyle}}">Status Atual
            <input type="text" value="{{condicaoAtual}}" disabled />
          </label>
          <div class="twbv-header-status-gif ferimentos-nivel-{{system.ferimentos}}" aria-hidden="true"></div>
        </div>
      </section>

      <section class="twbv-header-resources">
        <section class="twbv-panel twbv-ornate twbv-eco-panel resource-panel">
          <h2 class="twbv-eco-spend-trigger" role="button" tabindex="0" aria-label="Gastar 1 Eco">Eco</h2>
          <div class="twbv-eco-controls">
            <button type="button" class="twbv-eco-adjust twbv-eco-adjust--minus" data-adjust="-1" aria-label="Reduzir Eco">-</button>
            <div class="twbv-eco-core twbv-eco-spend-trigger" role="button" tabindex="0" aria-label="Gastar 1 Eco">
              <input type="number" name="system.eco" value="{{system.eco}}" min="0" aria-label="Valor de Eco" />
            </div>
            <button type="button" class="twbv-eco-adjust twbv-eco-adjust--plus" data-adjust="1" aria-label="Aumentar Eco">+</button>
          </div>
        </section>

        <section class="twbv-panel twbv-ornate mana-panel resource-panel">
          <h2 class="twbv-mana-trigger" role="button" tabindex="0" aria-label="Gastar 1 Mana">MANA</h2>
          <div class="twbv-mana-controls">
            <button type="button" class="mana-control mana-control--minus" data-adjust="-1" aria-label="Reduzir Mana">-</button>
            <div class="mana-orb">
              <input class="mana-value" type="number" name="system.mana.value" value="{{system.mana.value}}" min="0" aria-label="Valor de Mana" />
            </div>
            <button type="button" class="mana-control mana-control--plus" data-adjust="1" aria-label="Aumentar Mana">+</button>
          </div>
        </section>
      </section>
    </div>
  </header>

  <nav class="sheet-tabs tabs twbv-tabs" data-group="primary">
    <a class="item" data-tab="principal">Principal</a>
    <a class="item" data-tab="vantagens">Vant/Hab. Esp</a>
    <a class="item" data-tab="desvantagens">Desvantagens</a>
    <a class="item" data-tab="equipamento">Equipamento</a>
    <a class="item" data-tab="poderes">Poderes</a>
    <a class="item" data-tab="historia">Hist&oacute;ria</a>
    <a class="item" data-tab="avancos">Avan&ccedil;os</a>
    <a class="item" data-tab="efeitos">Efeitos</a>
  </nav>

  <section class="sheet-body twbv-tab-content">
    <div class="tab" data-group="primary" data-tab="principal">
      <div class="twbv-principal-grid twbv-principal-main">
        <section class="twbv-panel twbv-ornate twbv-attributes-panel">
          <h2 class="twbv-attributes-title">Atributos</h2>
          <div class="attributes-art-grid" role="group" aria-label="Atributos">
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="forca" title="Configurar b&ocirc;nus de For&ccedil;a"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-forca">For&ccedil;a</h3><label>Dado<select name="system.atributos.forca.passo">{{#select system.atributos.forca.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="forca" title="Rolar For&ccedil;a"><i class="fas fa-dice-d20"></i></button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="destreza" title="Configurar b&ocirc;nus de Destreza"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-destreza">Destreza</h3><label>Dado<select name="system.atributos.destreza.passo">{{#select system.atributos.destreza.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="destreza" title="Rolar Destreza"><i class="fas fa-dice-d20"></i></button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="constituicao" title="Configurar b&ocirc;nus de Constitui&ccedil;&atilde;o"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-constituicao">Constitui&ccedil;&atilde;o</h3><label>Dado<select name="system.atributos.constituicao.passo">{{#select system.atributos.constituicao.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="constituicao" title="Rolar Constitui&ccedil;&atilde;o"><i class="fas fa-dice-d20"></i></button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="inteligencia" title="Configurar b&ocirc;nus de Intelig&ecirc;ncia"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-inteligencia">Intelig&ecirc;ncia</h3><label>Dado<select name="system.atributos.inteligencia.passo">{{#select system.atributos.inteligencia.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="inteligencia" title="Rolar Intelig&ecirc;ncia"><i class="fas fa-dice-d20"></i></button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="influencia" title="Configurar b&ocirc;nus de Influ&ecirc;ncia"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-influencia">Influ&ecirc;ncia</h3><label>Dado<select name="system.atributos.influencia.passo">{{#select system.atributos.influencia.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="influencia" title="Rolar Influ&ecirc;ncia"><i class="fas fa-dice-d20"></i></button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="intuicao" title="Configurar b&ocirc;nus de Intui&ccedil;&atilde;o"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-intuicao">Intui&ccedil;&atilde;o</h3><label>Dado<select name="system.atributos.intuicao.passo">{{#select system.atributos.intuicao.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="intuicao" title="Rolar Intui&ccedil;&atilde;o"><i class="fas fa-dice-d20"></i></button></section>
          </div>
        </section>

        <div class="twbv-right-column">
          <section class="twbv-panel twbv-ornate twbv-defense-condition-panel">
            <div class="twbv-defense-condition-tabs">
              <label><input type="radio" name="twbv-defense-condition-view" value="defense" checked /><span>Defesas</span></label>
              <label><input type="radio" name="twbv-defense-condition-view" value="conditions" /><span>Condições</span></label>
            </div>

            <div class="twbv-defense-condition-pane twbv-defense-condition-pane--defense">
            <div class="twbv-defense-grid">
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaApararTooltip}}">
                <h3>Aparar</h3>
                                <input type="number" name="system.defesa.aparar" value="{{system.defesa.aparar}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaResistenciaTooltip}}">
                <h3>Resistência</h3>
                                <input type="number" name="system.defesa.resistencia" value="{{system.defesa.resistencia}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaDesviarTooltip}}">
                <h3>Desviar</h3>
                <input type="number" name="system.defesa.desviar" value="{{system.defesa.desviar}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaResistenciaMagicaTooltip}}">
                <h3>Resistência Mágica</h3>
                <input type="number" name="system.defesa.resistenciaMagica" value="{{system.defesa.resistenciaMagica}}" min="0" />
              </article>
            </div>
              <div class="twbv-size-move-grid">
              <article class="twbv-size-move-box">
                <h3>Tamanho</h3>
                <input type="number" name="system.tamanho" value="{{system.tamanho}}" />
              </article>
              <article class="twbv-size-move-box">
                <h3>Mov.</h3>
                <div class="twbv-mov-row">
                  <div class="twbv-mov-flat-wrap" data-mov-tooltip="{{movimentoTooltip}}">
                    <input type="number" value="{{movimentoTotal}}" disabled />
                  </div>
                  <div class="twbv-move-die-wrap" data-mov-tooltip="{{movimentoDieTooltip}}">
                    <button type="button" class="twbv-move-roll"><i class="fas fa-dice-d20"></i> {{movimentoDieLabel}}</button>
                  </div>
                </div>
              </article>
              </div>
            </div>

            <div class="twbv-defense-condition-pane twbv-defense-condition-pane--conditions">
            <div class="twbv-condition-board">
              <article class="twbv-condition-meter twbv-condition-meter--wounds ferimentos-nivel-{{system.ferimentos}}">
                <h3>Ferimentos</h3>
                <div class="twbv-condition-controls">
                  <button type="button" class="twbv-condition-adjust" data-path="system.ferimentos" data-min="0" data-max="{{woundMax}}" data-adjust="-1" aria-label="Reduzir ferimentos">?</button>
                  <div class="twbv-condition-core">
                    <input type="number" name="system.ferimentos" value="{{system.ferimentos}}" min="0" max="{{woundMax}}" />
                    <span>/{{woundMax}}</span>
                  </div>
                  <button type="button" class="twbv-condition-adjust" data-path="system.ferimentos" data-min="0" data-max="{{woundMax}}" data-adjust="1" aria-label="Aumentar ferimentos">+</button>
                </div>
              </article>

              <article class="twbv-condition-meter twbv-condition-meter--fatigue fadiga-nivel-{{system.fadiga}}">
                <h3>Fadiga</h3>
                <div class="twbv-condition-controls">
                  <button type="button" class="twbv-condition-adjust" data-path="system.fadiga" data-min="0" data-max="4" data-adjust="-1" aria-label="Reduzir fadiga">?</button>
                  <div class="twbv-condition-core">
                    <input type="number" name="system.fadiga" value="{{system.fadiga}}" min="0" max="4" />
                    <span>/4</span>
                  </div>
                  <button type="button" class="twbv-condition-adjust" data-path="system.fadiga" data-min="0" data-max="4" data-adjust="1" aria-label="Aumentar fadiga">+</button>
                </div>
              </article>

              <article class="twbv-condition-checklist">
                <div class="twbv-condition-checklist-grid">
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao1" {{checked system.condicao1}} />Condição 1</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao2" {{checked system.condicao2}} />Condição 2</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao3" {{checked system.condicao3}} />Condição 3</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao4" {{checked system.condicao4}} />Condição 4</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao5" {{checked system.condicao5}} />Condição 5</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao6" {{checked system.condicao6}} />Condição 6</label>
                </div>
              </article>
              </div>
            </div>
          </section>
          <section class="twbv-panel twbv-ornate twbv-favorites-panel">
            <div class="twbv-favorites-header">
              <h2>Favoritos</h2>
              <div class="twbv-favorites-tools">
                <span>{{favorites.length}}</span>
                <button type="button" class="twbv-open-floating-favorites" title="Abrir favoritos flutuantes"><i class="fas fa-star"></i></button>
              </div>
            </div>
            <div class="twbv-favorites-list">
              {{#each favorites as |item|}}
                <article class="twbv-favorite-card item item-edit item-type-{{item.type}}" data-item-id="{{item._id}}" data-item-uuid="{{item.uuid}}" draggable="true">
                  <img src="{{item.img}}" alt="{{item.name}}" />
                  <div>
                    <strong>{{item.name}}</strong>
                    <span>{{item.typeLabel}}</span>
                  </div>
                </article>
              {{else}}
                <p class="twbv-favorites-empty">Marque itens com estrela para aparecerem aqui.</p>
              {{/each}}
            </div>
          </section>
        </div>

        <section class="twbv-panel twbv-ornate">
          <div class="twbv-pericias-header">
            <h2>Perícias</h2>
            <div class="twbv-pericias-actions">
              <button type="button" class="twbv-sort-skills {{#if skillSortActive}}is-active{{/if}}" title="{{#if skillSortActive}}Restaurar ordem anterior{{else}}Ordenar perícias em ordem alfabética{{/if}}"><i class="fas fa-sort-alpha-down"></i></button>
              <button type="button" class="twbv-open-skill-compendium" title="Abrir compêndio de perícias"><i class="fas fa-book-open"></i></button>
              <button type="button" class="twbv-add-skill" title="Adicionar perícia"><i class="fas fa-plus"></i> Adicionar Perícia</button>
            </div>
          </div>
          <div class="twbv-skills-grid">
            {{#each system.pericias as |pericia i|}}
              <div class="twbv-skill-row" data-index="{{i}}" draggable="true">
                <button type="button" class="twbv-skill-roll twbv-skill-icon" data-index="{{i}}" title="Rolar perícia {{pericia.nome}}"><img src="{{pericia.iconPath}}" class="twbv-skill-icon-img" alt="{{pericia.nome}}"></button>
                <button type="button" class="twbv-edit-skill-config" data-index="{{i}}" title="Configurar perícia">
                  <span class="twbv-skill-name">{{pericia.nome}}</span>
                  <span class="twbv-skill-meta">
                    <span class="twbv-skill-attr twbv-attr-{{pericia.atributo}}">{{pericia.attributeMeta.label}}</span>
                    <span class="twbv-skill-rank {{pericia.rank.cssClass}}">{{pericia.rank.label}}</span>
                  </span>
                </button>
                <span class="twbv-skill-die">{{pericia.rollLabel}}</span>
                <button type="button" class="twbv-toggle-skill-lock" data-index="{{i}}" title="{{#if pericia.locked}}Destravar perícia{{else}}Travar perícia{{/if}}"><i class="fas {{#if pericia.locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
                <button type="button" class="twbv-remove-skill" data-index="{{i}}" title="Remover perícia"><i class="fas fa-trash"></i></button>
              </div>
            {{else}}
              <div class="twbv-skills-empty"></div>
            {{/each}}
          </div>
          <section class="twbv-skill-levels-panel">
            <h3 class="twbv-skill-levels-title">NÍVEIS DE PERÍCIA</h3>
            <div class="twbv-skill-levels-grid">
              <article class="twbv-skill-level-card rank-novato"><h4>NOVATO</h4><p>Pouca ou nenhuma experiência na área.</p></article>
              <article class="twbv-skill-level-card rank-treinado"><h4>TREINADO</h4><p>Conhecimento básico e prática constante.</p></article>
              <article class="twbv-skill-level-card rank-experiente"><h4>EXPERIENTE</h4><p>Ampla experiência e confiança.</p></article>
              <article class="twbv-skill-level-card rank-especialista"><h4>ESPECIALISTA</h4><p>Domínio elevado e precisão notável.</p></article>
              <article class="twbv-skill-level-card rank-mestre"><h4>MESTRE</h4><p>Excelência quase lendária.</p></article>
            </div>
          </section>
        </section>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="vantagens">
      <div class="twbv-panel twbv-ornate twbv-traits-page">
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--advantage">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Vantagens</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-trait-division-create twbv-trait-create twbv-trait-create--division"><i class="fas fa-layer-group"></i> Criar Divis&atilde;o</button><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--advantage" data-type="vantagem" data-label="Vantagem" data-dialog-version="2"><i class="fas fa-plus"></i> Adicionar Vantagem</button></div></div>
          <div class="twbv-item-card-list">
            {{#unless vantagemHasContent}}<p class="twbv-adv-empty twbv-trait-empty">Nenhuma vantagem cadastrada.</p>{{/unless}}
            {{#each vantagemItemsSemDivisao as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-gem"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="vantagem"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">{{#if item.categoria}}Categoria: {{item.categoria}} &middot; {{/if}}Requisito/Tier: {{#if item.requisitos}}{{item.requisitos}}{{else}}-{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descri&ccedil;&atilde;o.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{/each}}
            {{#each vantagemDivisoes as |division|}}
              <section class="twbv-trait-division" data-division-id="{{division.id}}" data-division-name="{{division.name}}">
                <header class="twbv-trait-division-header">
                  <span aria-hidden="true"></span>
                  {{#if division.isManual}}<button type="button" class="twbv-trait-division-delete" data-division-id="{{division.id}}" data-division-name="{{division.name}}" title="Remover divis&atilde;o"><i class="fas fa-trash"></i></button>{{/if}}
                </header>
                <div class="twbv-item-card-list twbv-item-card-list--division" data-division-id="{{division.id}}" data-division-name="{{division.name}}">
                  {{#each division.items as |item|}}
                    <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                      <div class="twbv-item-card-layout">
                        <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-gem"></i>{{/if}}</div>
                        <div class="twbv-item-card-content">
                          <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="vantagem"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                          <div class="twbv-item-card-meta">Categoria: {{item.categoria}}{{#if item.requisitos}} &middot; Requisito/Tier: {{item.requisitos}}{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descri&ccedil;&atilde;o.{{/if}}</p>
                        </div>
                      </div>
                    </article>
                  {{else}}<p class="twbv-trait-division-empty" aria-hidden="true"></p>{{/each}}
                </div>
              </section>
            {{/each}}
          </div>
        </div>
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--special">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Habilidades Especiais</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--special" data-type="habilidadeEspecial" data-label="Habilidade Especial" data-dialog-version="2"><i class="fas fa-plus"></i> Adicionar Hab. Esp.</button></div></div>
          <div class="twbv-item-card-list">
            {{#each habilidadesEspeciais as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-scroll"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
