<form class="twbv-sheet {{cssClass}}" autocomplete="off">
  <header class="twbv-top-frame twbv-ornate">
    <h1 class="twbv-title">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do Personagem" />
    </h1>

    <div class="twbv-header-layout">
      <section class="twbv-header-side twbv-header-left twbv-panel twbv-ornate">
        <h2>Nome</h2>
        <input name="name" type="text" value="{{actor.name}}" />
      </section>

      <section class="twbv-header-center twbv-panel twbv-ornate">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </section>

      <section class="twbv-header-side twbv-header-right twbv-panel twbv-ornate">
        <h2>Conceito & Origem</h2>
        <label>Conceito
          <input type="text" name="system.conceito" value="{{system.conceito}}" />
        </label>
        <label>Origem
          <input type="text" name="system.origem" value="{{system.origem}}" />
        </label>
      </section>
    </div>
  </header>

  <nav class="sheet-tabs tabs twbv-tabs" data-group="primary">
    <a class="item" data-tab="principal">Principal</a>
    <a class="item" data-tab="poderes">Poderes</a>
    <a class="item" data-tab="vantagens">Vantagens</a>
    <a class="item" data-tab="desvantagens">Desvantagens</a>
    <a class="item" data-tab="equipamento">Equipamento</a>
    <a class="item" data-tab="historia">História</a>
    <a class="item" data-tab="efeitos">Efeitos</a>
    <a class="item" data-tab="avancos">Avanços</a>
  </nav>

  <section class="sheet-body twbv-tab-content">
    <div class="tab" data-group="primary" data-tab="principal">
      <div class="twbv-principal-grid twbv-principal-main">
        <section class="twbv-panel twbv-ornate">
          <h2>Atributos</h2>
          <div class="twbv-attributes-grid">
            <section class="twbv-attribute-card"><h3>Força</h3><input type="number" name="system.atributos.forca.valor" value="{{system.atributos.forca.valor}}" /></section>
            <section class="twbv-attribute-card"><h3>Destreza</h3><input type="number" name="system.atributos.destreza.valor" value="{{system.atributos.destreza.valor}}" /></section>
            <section class="twbv-attribute-card"><h3>Constituição</h3><input type="number" name="system.atributos.constituicao.valor" value="{{system.atributos.constituicao.valor}}" /></section>
            <section class="twbv-attribute-card"><h3>Inteligência</h3><input type="number" name="system.atributos.inteligencia.valor" value="{{system.atributos.inteligencia.valor}}" /></section>
            <section class="twbv-attribute-card"><h3>Intuição</h3><input type="number" name="system.atributos.intuicao.valor" value="{{system.atributos.intuicao.valor}}" /></section>
            <section class="twbv-attribute-card"><h3>Vontade</h3><input type="number" name="system.atributos.vontade.valor" value="{{system.atributos.vontade.valor}}" /></section>
          </div>
        </section>

        <section class="twbv-panel twbv-ornate twbv-eco-panel">
          <h2>Eco</h2>
          <div class="twbv-eco-controls">
            <button type="button" class="twbv-eco-adjust" data-adjust="-1">-</button>
            <input type="number" name="system.eco" value="{{system.eco}}" min="0" />
            <button type="button" class="twbv-eco-adjust" data-adjust="1">+</button>
          </div>
        </section>

        <section class="twbv-panel twbv-ornate">
          <h2>Perícias</h2>
          <div class="twbv-skills-grid">
            {{#each system.pericias as |pericia i|}}
              <div class="twbv-skill-row" data-index="{{i}}" draggable="true">
                <button type="button" class="twbv-skill-roll twbv-skill-icon" data-index="{{i}}" title="Rolar perícia {{pericia.nome}}"><img src="{{pericia.attributeMeta.iconPath}}" class="attribute-icon-img" alt="{{pericia.attributeMeta.label}}"></button>
                <button type="button" class="twbv-edit-skill-config" data-index="{{i}}" title="Configurar perícia">
                  <span class="twbv-skill-name">{{pericia.nome}}</span>
                  <span class="twbv-skill-attr twbv-attr-{{pericia.atributo}}"><img src="{{pericia.attributeMeta.iconPath}}" class="attribute-icon-img" alt="{{pericia.attributeMeta.label}}"> {{pericia.attributeMeta.label}}</span>
                  <span class="twbv-skill-rank {{pericia.rank.cssClass}}">{{pericia.rank.label}}</span>
                </button>
                <button type="button" class="twbv-edit-skill-roll" data-index="{{i}}" title="Rolar com dado {{pericia.rollLabel}}">{{pericia.rollLabel}}</button>
                <div class="twbv-skill-controls">
                  <button type="button" class="twbv-toggle-skill-lock" data-index="{{i}}" title="{{#if pericia.locked}}Destravar perícia{{else}}Travar perícia{{/if}}"><i class="fas {{#if pericia.locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
                  <button type="button" class="twbv-remove-skill" data-index="{{i}}" title="Remover perícia"><i class="fas fa-trash"></i></button>
                </div>
              </div>
            {{else}}
              <div class="twbv-skills-empty"></div>
            {{/each}}
          </div>
        </section>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="avancos">
      <section class="twbv-panel twbv-ornate">
        <div class="twbv-adv-header">
          <h2>Avanços</h2>
          <button type="button" class="twbv-add-advancement"><i class="fas fa-plus"></i> Adicionar avanço</button>
        </div>
        <label>Avanços totais
          <input type="number" name="system.avancosTotais" value="{{system.avancosTotais}}" min="0" />
        </label>
        <label>Estágio atual
          <input type="text" value="{{stageName}}" disabled />
        </label>
        <div class="twbv-stages-grid">
          {{#each stages as |stage|}}
            <div class="twbv-stage-chip {{#if stage.current}}is-current{{/if}}">
              <span class="twbv-stage-name">{{stage.name}}</span>
              <span class="twbv-stage-range">{{stage.range}}</span>
            </div>
          {{/each}}
        </div>
        <div class="twbv-adv-list">
          {{#each system.avancos as |avanco i|}}
            <div class="twbv-adv-row">
              <span class="twbv-adv-index">#{{i}}</span>
              <select name="system.avancos.{{i}}.tipo">
                {{#select avanco.tipo}}
                  <option value="">Selecione...</option>
                  {{#each @root.advancementOptions as |opt|}}<option value="{{opt}}">{{opt}}</option>{{/each}}
                {{/select}}
              </select>
              <button type="button" class="twbv-remove-advancement" data-index="{{i}}"><i class="fas fa-trash"></i></button>
            </div>
          {{/each}}
        </div>
      </section>
    </div>

    <div class="tab" data-group="primary" data-tab="poderes"><div class="twbv-panel twbv-ornate"><h2>Poderes</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="vantagens"><div class="twbv-panel twbv-ornate"><h2>Vantagens</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="desvantagens"><div class="twbv-panel twbv-ornate"><h2>Desvantagens</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="equipamento"><div class="twbv-panel twbv-ornate"><h2>Equipamento</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="historia"><div class="twbv-panel twbv-ornate"><h2>História</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="efeitos"><div class="twbv-panel twbv-ornate"><h2>Efeitos</h2><p>Em construção.</p></div></div>
  </section>
</form>
