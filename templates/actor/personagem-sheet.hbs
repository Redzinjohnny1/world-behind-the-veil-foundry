<form class="twbv-sheet {{cssClass}} twbv-actor-kind-{{actorKind}}" autocomplete="off">
  <header class="twbv-top-frame twbv-ornate">
    <h1 class="twbv-title">
      <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do Personagem" />
    </h1>

    <div class="twbv-header-layout">
      <section class="twbv-header-portrait twbv-panel twbv-ornate">
        <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
      </section>

      <section class="twbv-header-identity twbv-panel twbv-ornate">
                <label>Codinome
          <input type="text" name="system.codinome" value="{{system.codinome}}" placeholder="Codinome" />
        </label>
        <label>Conceito
          <input type="text" name="system.conceito" value="{{system.conceito}}" />
        </label>
        <label>Naturalidade / Nacionalidade
          <input type="text" name="system.origem" value="{{system.origem}}" />
        </label>
        <label>Tier Atual
          <input type="text" value="{{stageName}}" disabled />
        </label>
        <label>Avanço
          <input type="number" value="{{system.avancosTotais}}" disabled />
        </label>
        <div class="twbv-header-status-row">
          <label class="twbv-header-status ferimentos-nivel-{{system.ferimentos}} {{conditionStateClass}}" style="{{conditionStateStyle}}">Status Atual
            <input type="text" value="{{condicaoAtual}}" disabled />
          </label>
          <div class="twbv-header-status-gif ferimentos-nivel-{{system.ferimentos}}" aria-hidden="true"></div>
        </div>
      </section>

      <section class="twbv-header-resources">
        <section class="twbv-panel twbv-ornate twbv-eco-panel resource-panel">
          <h2 class="twbv-eco-spend-trigger" role="button" tabindex="0" aria-label="Gastar 1 Eco">Eco</h2>
          <div class="twbv-eco-controls">
            <button type="button" class="twbv-eco-adjust twbv-eco-adjust--minus" data-adjust="-1" aria-label="Reduzir Eco">-</button>
            <div class="twbv-eco-core twbv-eco-spend-trigger" role="button" tabindex="0" aria-label="Gastar 1 Eco">
              <input type="number" name="system.eco" value="{{system.eco}}" min="0" aria-label="Valor de Eco" />
            </div>
            <button type="button" class="twbv-eco-adjust twbv-eco-adjust--plus" data-adjust="1" aria-label="Aumentar Eco">+</button>
          </div>
        </section>

        <section class="twbv-panel twbv-ornate mana-panel resource-panel">
          <h2 class="twbv-mana-trigger" role="button" tabindex="0" aria-label="Gastar 1 Mana">MANA</h2>
          <div class="twbv-mana-controls">
            <button type="button" class="mana-control mana-control--minus" data-adjust="-1" aria-label="Reduzir Mana">-</button>
            <div class="mana-orb">
              <input class="mana-value" type="number" name="system.mana.value" value="{{system.mana.value}}" min="0" aria-label="Valor de Mana" />
            </div>
            <button type="button" class="mana-control mana-control--plus" data-adjust="1" aria-label="Aumentar Mana">+</button>
          </div>
        </section>
      </section>
    </div>
  </header>

  <nav class="sheet-tabs tabs twbv-tabs" data-group="primary">
    <a class="item" data-tab="principal">Principal</a>
    <a class="item" data-tab="vantagens">Vant/Hab. Esp</a>
    <a class="item" data-tab="desvantagens">Desvantagens</a>
    <a class="item" data-tab="equipamento">Equipamento</a>
    <a class="item" data-tab="poderes">Poderes</a>
    <a class="item" data-tab="historia">História</a>
    <a class="item" data-tab="avancos">Avanços</a>
    <a class="item" data-tab="efeitos">Efeitos</a>
  </nav>

  <section class="sheet-body twbv-tab-content">
    <div class="tab" data-group="primary" data-tab="principal">
      <div class="twbv-principal-grid twbv-principal-main">
        <section class="twbv-panel twbv-ornate twbv-attributes-panel">
          <h2 class="twbv-attributes-title">Atributos</h2>
          <div class="attributes-art-grid" role="group" aria-label="Atributos">
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="forca" title="Configurar bônus de Força"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-forca">Força</h3><label>Dado<select name="system.atributos.forca.passo">{{#select system.atributos.forca.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="forca" title="Rolar Força">🎲</button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="destreza" title="Configurar bônus de Destreza"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-destreza">Destreza</h3><label>Dado<select name="system.atributos.destreza.passo">{{#select system.atributos.destreza.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="destreza" title="Rolar Destreza">🎲</button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="constituicao" title="Configurar bônus de Constituição"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-constituicao">Constituição</h3><label>Dado<select name="system.atributos.constituicao.passo">{{#select system.atributos.constituicao.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="constituicao" title="Rolar Constituição">🎲</button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="inteligencia" title="Configurar bônus de Inteligência"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-inteligencia">Inteligência</h3><label>Dado<select name="system.atributos.inteligencia.passo">{{#select system.atributos.inteligencia.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="inteligencia" title="Rolar Inteligência">🎲</button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="influencia" title="Configurar bônus de Influência"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-influencia">Influência</h3><label>Dado<select name="system.atributos.influencia.passo">{{#select system.atributos.influencia.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="influencia" title="Rolar Influência">🎲</button></section>
              <section class="twbv-attribute-card"><button type="button" class="twbv-attr-config" data-attr="intuicao" title="Configurar bônus de Intuição"><i class="fas fa-cog"></i></button><h3 class="twbv-attr-intuicao">Intuição</h3><label>Dado<select name="system.atributos.intuicao.passo">{{#select system.atributos.intuicao.passo}}{{#each @root.attributeOptions as |opt|}}<option value="{{opt.value}}">{{opt.label}}</option>{{/each}}{{/select}}</select></label><button type="button" class="twbv-attr-roll" data-attr="intuicao" title="Rolar Intuição">🎲</button></section>
          </div>
        </section>

        <div class="twbv-right-column">
          <section class="twbv-panel twbv-ornate twbv-defense-condition-panel">
            <div class="twbv-defense-condition-tabs">
              <label><input type="radio" name="twbv-defense-condition-view" value="defense" checked /><span>Defesas</span></label>
              <label><input type="radio" name="twbv-defense-condition-view" value="conditions" /><span>Condições</span></label>
            </div>

            <div class="twbv-defense-condition-pane twbv-defense-condition-pane--defense">
            <div class="twbv-defense-grid">
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaApararTooltip}}">
                <h3>Aparar</h3>
                                <input type="number" name="system.defesa.aparar" value="{{system.defesa.aparar}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaResistenciaTooltip}}">
                <h3>Resistência</h3>
                                <input type="number" name="system.defesa.resistencia" value="{{system.defesa.resistencia}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaDesviarTooltip}}">
                <h3>Desviar</h3>
                <input type="number" name="system.defesa.desviar" value="{{system.defesa.desviar}}" min="0" />
              </article>
              <article class="twbv-defense-box" data-twbv-tooltip="{{defesaResistenciaMagicaTooltip}}">
                <h3>Resistência Mágica</h3>
                <input type="number" name="system.defesa.resistenciaMagica" value="{{system.defesa.resistenciaMagica}}" min="0" />
              </article>
            </div>
              <div class="twbv-size-move-grid">
              <article class="twbv-size-move-box">
                <h3>Tamanho</h3>
                <input type="number" name="system.tamanho" value="{{system.tamanho}}" />
              </article>
              <article class="twbv-size-move-box">
                <h3>Mov.</h3>
                <div class="twbv-mov-row">
                  <div class="twbv-mov-flat-wrap" data-mov-tooltip="{{movimentoTooltip}}">
                    <input type="number" value="{{movimentoTotal}}" disabled />
                  </div>
                  <div class="twbv-move-die-wrap" data-mov-tooltip="{{movimentoDieTooltip}}">
                    <button type="button" class="twbv-move-roll">🎲 {{movimentoDieLabel}}</button>
                  </div>
                </div>
              </article>
              </div>
            </div>

            <div class="twbv-defense-condition-pane twbv-defense-condition-pane--conditions">
            <div class="twbv-condition-board">
              <article class="twbv-condition-meter twbv-condition-meter--wounds ferimentos-nivel-{{system.ferimentos}}">
                <h3>Ferimentos</h3>
                <div class="twbv-condition-controls">
                  <button type="button" class="twbv-condition-adjust" data-path="system.ferimentos" data-min="0" data-max="{{woundMax}}" data-adjust="-1" aria-label="Reduzir ferimentos">−</button>
                  <div class="twbv-condition-core">
                    <input type="number" name="system.ferimentos" value="{{system.ferimentos}}" min="0" max="{{woundMax}}" />
                    <span>/{{woundMax}}</span>
                  </div>
                  <button type="button" class="twbv-condition-adjust" data-path="system.ferimentos" data-min="0" data-max="{{woundMax}}" data-adjust="1" aria-label="Aumentar ferimentos">+</button>
                </div>
              </article>

              <article class="twbv-condition-meter twbv-condition-meter--fatigue fadiga-nivel-{{system.fadiga}}">
                <h3>Fadiga</h3>
                <div class="twbv-condition-controls">
                  <button type="button" class="twbv-condition-adjust" data-path="system.fadiga" data-min="0" data-max="4" data-adjust="-1" aria-label="Reduzir fadiga">−</button>
                  <div class="twbv-condition-core">
                    <input type="number" name="system.fadiga" value="{{system.fadiga}}" min="0" max="4" />
                    <span>/4</span>
                  </div>
                  <button type="button" class="twbv-condition-adjust" data-path="system.fadiga" data-min="0" data-max="4" data-adjust="1" aria-label="Aumentar fadiga">+</button>
                </div>
              </article>

              <article class="twbv-condition-checklist">
                <div class="twbv-condition-checklist-grid">
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao1" {{checked system.condicao1}} />Condição 1</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao2" {{checked system.condicao2}} />Condição 2</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao3" {{checked system.condicao3}} />Condição 3</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao4" {{checked system.condicao4}} />Condição 4</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao5" {{checked system.condicao5}} />Condição 5</label>
                  <label class="twbv-condition-check-item"><input type="checkbox" name="system.condicao6" {{checked system.condicao6}} />Condição 6</label>
                </div>
              </article>
              </div>
            </div>
          </section>
          <section class="twbv-panel twbv-ornate twbv-favorites-panel">
            <div class="twbv-favorites-header">
              <h2>Favoritos</h2>
              <div class="twbv-favorites-tools">
                <span>{{favorites.length}}</span>
                <button type="button" class="twbv-open-floating-favorites" title="Abrir favoritos flutuantes"><i class="fas fa-star"></i></button>
              </div>
            </div>
            <div class="twbv-favorites-list">
              {{#each favorites as |item|}}
                <article class="twbv-favorite-card item item-edit item-type-{{item.type}}" data-item-id="{{item._id}}" data-item-uuid="{{item.uuid}}" draggable="true">
                  <img src="{{item.img}}" alt="{{item.name}}" />
                  <div>
                    <strong>{{item.name}}</strong>
                    <span>{{item.typeLabel}}</span>
                  </div>
                </article>
              {{else}}
                <p class="twbv-favorites-empty">Marque itens com estrela para aparecerem aqui.</p>
              {{/each}}
            </div>
          </section>
        </div>

        <section class="twbv-panel twbv-ornate">
          <div class="twbv-pericias-header">
            <h2>Perícias</h2>
            <div class="twbv-pericias-actions">
              <button type="button" class="twbv-sort-skills {{#if skillSortActive}}is-active{{/if}}" title="{{#if skillSortActive}}Restaurar ordem anterior{{else}}Ordenar perícias em ordem alfabética{{/if}}"><i class="fas fa-sort-alpha-down"></i></button>
              <button type="button" class="twbv-add-skill" title="Adicionar perícia"><i class="fas fa-plus"></i> Adicionar Perícia</button>
            </div>
          </div>
          <div class="twbv-skills-grid">
            {{#each system.pericias as |pericia i|}}
              <div class="twbv-skill-row" data-index="{{i}}" draggable="true">
                <button type="button" class="twbv-skill-roll twbv-skill-icon" data-index="{{i}}" title="Rolar perícia {{pericia.nome}}"><img src="{{pericia.attributeMeta.iconPath}}" class="attribute-icon-img" alt="{{pericia.attributeMeta.label}}"></button>
                <button type="button" class="twbv-edit-skill-config" data-index="{{i}}" title="Configurar perícia">
                  <span class="twbv-skill-name">{{pericia.nome}}</span>
                  <span class="twbv-skill-meta">
                    <span class="twbv-skill-attr twbv-attr-{{pericia.atributo}}">{{pericia.attributeMeta.label}}</span>
                    <span class="twbv-skill-rank {{pericia.rank.cssClass}}">{{pericia.rank.label}}</span>
                  </span>
                </button>
                <span class="twbv-skill-die">{{pericia.rollLabel}}</span>
                <button type="button" class="twbv-toggle-skill-lock" data-index="{{i}}" title="{{#if pericia.locked}}Destravar perícia{{else}}Travar perícia{{/if}}"><i class="fas {{#if pericia.locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></button>
                <button type="button" class="twbv-remove-skill" data-index="{{i}}" title="Remover perícia"><i class="fas fa-trash"></i></button>
              </div>
            {{else}}
              <div class="twbv-skills-empty"></div>
            {{/each}}
          </div>
          <section class="twbv-skill-levels-panel">
            <h3 class="twbv-skill-levels-title">NÍVEIS DE PERÍCIA</h3>
            <div class="twbv-skill-levels-grid">
              <article class="twbv-skill-level-card rank-novato"><h4>NOVATO</h4><p>Pouca ou nenhuma experiência na área.</p></article>
              <article class="twbv-skill-level-card rank-treinado"><h4>TREINADO</h4><p>Conhecimento básico e prática constante.</p></article>
              <article class="twbv-skill-level-card rank-experiente"><h4>EXPERIENTE</h4><p>Ampla experiência e confiança.</p></article>
              <article class="twbv-skill-level-card rank-especialista"><h4>ESPECIALISTA</h4><p>Domínio elevado e precisão notável.</p></article>
              <article class="twbv-skill-level-card rank-mestre"><h4>MESTRE</h4><p>Excelência quase lendária.</p></article>
            </div>
          </section>
        </section>
      </div>
    </div>

    <div class="tab" data-group="primary" data-tab="vantagens">
      <div class="twbv-panel twbv-ornate twbv-traits-page">
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--advantage">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Vantagens</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-trait-division-create twbv-trait-create twbv-trait-create--division"><i class="fas fa-layer-group"></i> Criar Divisao</button><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--advantage" data-type="vantagem" data-label="Vantagem" data-dialog-version="2"><i class="fas fa-plus"></i> Adicionar Vantagem</button></div></div>
          <div class="twbv-item-card-list">
            {{#unless vantagemHasContent}}<p class="twbv-adv-empty twbv-trait-empty">Nenhuma vantagem cadastrada.</p>{{/unless}}
            {{#each vantagemItemsSemDivisao as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-gem"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="vantagem"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">{{#if item.categoria}}Categoria: {{item.categoria}} &middot; {{/if}}Requisito/Tier: {{#if item.requisitos}}{{item.requisitos}}{{else}}-{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descrição.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{/each}}
            {{#each vantagemDivisoes as |division|}}
              <section class="twbv-trait-division" data-division-id="{{division.id}}" data-division-name="{{division.name}}">
                <header class="twbv-trait-division-header">
                  <span aria-hidden="true"></span>
                  {{#if division.isManual}}<button type="button" class="twbv-trait-division-delete" data-division-id="{{division.id}}" data-division-name="{{division.name}}" title="Remover divisao"><i class="fas fa-trash"></i></button>{{/if}}
                </header>
                <div class="twbv-item-card-list twbv-item-card-list--division" data-division-id="{{division.id}}" data-division-name="{{division.name}}">
                  {{#each division.items as |item|}}
                    <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                      <div class="twbv-item-card-layout">
                        <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-gem"></i>{{/if}}</div>
                        <div class="twbv-item-card-content">
                          <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="vantagem"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                          <div class="twbv-item-card-meta">Categoria: {{item.categoria}}{{#if item.requisitos}} &middot; Requisito/Tier: {{item.requisitos}}{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descricao.{{/if}}</p>
                        </div>
                      </div>
                    </article>
                  {{else}}<p class="twbv-trait-division-empty" aria-hidden="true"></p>{{/each}}
                </div>
              </section>
            {{/each}}
          </div>
        </div>
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--special">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Habilidades Especiais</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--special" data-type="habilidadeEspecial" data-label="Habilidade Especial" data-dialog-version="2"><i class="fas fa-plus"></i> Adicionar Hab. Esp.</button></div></div>
          <div class="twbv-item-card-list">
            {{#each habilidadesEspeciais as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-scroll"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="habilidadeEspecial"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">Categoria: {{#if item.categoria}}{{item.categoria}}{{else}}-{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descrição.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{else}}<p class="twbv-adv-empty twbv-trait-empty">Nenhuma habilidade especial cadastrada.</p>{{/each}}
          </div>
        </div>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="desvantagens">
      <div class="twbv-panel twbv-ornate twbv-traits-page">
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--hindrance">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Desvantagens</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--hindrance" data-type="desvantagem" data-label="Desvantagem" data-dialog-version="2"><i class="fas fa-plus"></i> Adicionar Desv.</button></div></div>
          <div class="twbv-item-card-list">
            {{#each desvantagens as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-skull"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="desvantagem" data-dialog-version="2"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">{{#if item.categoria}}Categoria: {{item.categoria}} &middot; {{/if}}Requisito/Tier: {{#if item.requisitos}}{{item.requisitos}}{{else}}-{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descrição.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{else}}<p class="twbv-adv-empty twbv-trait-empty">Nenhuma desvantagem cadastrada.</p>{{/each}}
          </div>
        </div>
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--complication">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Complicações</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--complication" data-type="complicacao" data-label="Complicação" data-dialog-version="2"><i class="fas fa-plus"></i> Adicionar Complic.</button></div></div>
          <div class="twbv-item-card-list">
            {{#each complicacoes as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-exclamation-triangle"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="complicacao" data-dialog-version="2"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">{{#if item.categoria}}Categoria: {{item.categoria}} &middot; {{/if}}Fonte: {{#if item.fonte}}{{item.fonte}}{{else}}-{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descrição.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{else}}<p class="twbv-adv-empty twbv-trait-empty">Nenhuma complicação cadastrada.</p>{{/each}}
          </div>
        </div>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="equipamento">
      <div class="twbv-panel twbv-ornate">
        <section class="equipment-tab-wrap">
          <header class="equipment-header">
            <h2>Equipamentos</h2>
          </header>

          <div class="twbv-equipment-view-switch">
            <label><input type="radio" name="twbv-equipment-view" value="inventory" {{#ifEquals equipmentView "inventory"}}checked{{/ifEquals}} /><span><i class="fas fa-list"></i> Inventário</span></label>
            <label><input type="radio" name="twbv-equipment-view" value="body" {{#ifEquals equipmentView "body"}}checked{{/ifEquals}} /><span><i class="fas fa-street-view"></i> Corpo</span></label>
          </div>

          <section class="equipment-section twbv-equipment-body-panel">
            <header class="twbv-body-map-header">
              <h3>Slots Corporais</h3>
              <div class="twbv-body-map-actions">
                <p>Equipe ou arraste itens para o ponto correspondente.</p>
                <button type="button" class="twbv-body-line-create"><i class="fas fa-plus"></i> Linha</button>
                <button type="button" class="twbv-body-line-reset"><i class="fas fa-undo"></i> Limpar linhas</button>
              </div>
            </header>
            <div class="twbv-body-map">
              <div class="twbv-body-aura"></div>
              <img class="twbv-body-map-img" src="systems/world-behind-the-veil/assets/background/humanBodyRoxo.gif" alt="Mapa corporal" />
              {{#each bodyLines as |line|}}
                <div class="twbv-body-custom-line" data-line-id="{{line.id}}" style="{{line.style}}">
                  <button type="button" class="twbv-body-line-delete" title="Remover linha"><i class="fas fa-times"></i></button>
                  <span class="twbv-body-line-end" title="Redimensionar e girar"></span>
                </div>
              {{/each}}
              {{#each bodySlots as |slot|}}
                <article class="twbv-body-slot twbv-body-slot--{{slot.key}}" data-slot-key="{{slot.key}}" style="{{slot.positionStyle}}">
                  <span class="twbv-body-slot-line"></span>
                  <div class="twbv-body-slot-card">
                    <button type="button" class="twbv-body-slot-handle" title="Mover slot"><i class="fas fa-arrows-alt"></i></button>
                    <div class="twbv-body-slot-img">
                      {{#if slot.item}}
                        <img src="{{slot.item.img}}" alt="{{slot.item.name}}" />
                      {{else}}
                        <i class="fas fa-plus"></i>
                      {{/if}}
                    </div>
                    <div class="twbv-body-slot-text">
                      <strong>{{slot.label}}</strong>
                      {{#if slot.item}}
                        <span>{{slot.item.name}}</span>
                        <button type="button" class="twbv-body-slot-unequip" data-item-id="{{slot.item.id}}"><i class="fas fa-link-slash"></i> Desequipar</button>
                      {{else}}
                        <span>Vazio</span>
                      {{/if}}
                    </div>
                  </div>
                </article>
              {{/each}}
            </div>
          </section>

          <div class="twbv-equipment-subpanel twbv-equipment-inventory-panel">
            <section class="equipment-section weapons">
              <div class="equipment-section-title"><h3>Armas</h3><a class="item-create" data-type="arma"><i class="fas fa-plus"></i> Arma</a></div>
              <div class="equipment-grid">
                {{#each equipment.weapons as |item|}}
                  {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
                {{/each}}
              </div>
            </section>

            <section class="equipment-section armors">
              <div class="equipment-section-title"><h3>Armaduras</h3><a class="item-create" data-type="armadura"><i class="fas fa-plus"></i> Armadura</a></div>
              <div class="equipment-grid">
                {{#each equipment.armors as |item|}}
                  {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
                {{/each}}
              </div>
            </section>

            <section class="equipment-section magazines">
              <div class="equipment-section-title"><h3>Carregadores</h3><a class="item-create" data-type="municao"><i class="fas fa-plus"></i> Carregador</a></div>
              <div class="equipment-grid">
                {{#each equipment.magazines as |item|}}
                  {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
                {{/each}}
              </div>
            </section>

          <section class="equipment-section ammunitions">
            <div class="equipment-section-title"><h3>Munições</h3><a class="item-create" data-type="municao"><i class="fas fa-plus"></i> Munição</a></div>
            <div class="equipment-grid">
              {{#each equipment.ammunitions as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section consumables">
            <div class="equipment-section-title"><h3>Consumíveis</h3><a class="item-create" data-type="consumable"><i class="fas fa-plus"></i> Consumível</a></div>
            <div class="equipment-grid">
              {{#each equipment.consumables as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>

          <section class="equipment-section others">
            <div class="equipment-section-title"><h3>Outros</h3><a class="item-create" data-type="modificacao"><i class="fas fa-plus"></i> Modificação</a></div>
            <div class="equipment-grid">
              {{#each equipment.others as |item|}}
                {{> "systems/world-behind-the-veil/templates/actor/parts/equipment-card.hbs" item=item}}
              {{/each}}
            </div>
          </section>
          </div>
        </section>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="poderes">
      <div class="twbv-panel twbv-ornate twbv-traits-page twbv-powers-page">
        <div class="twbv-item-section twbv-trait-section twbv-trait-section--power">
          <div class="twbv-item-tab-header twbv-trait-header"><h2>Poderes</h2><div class="twbv-item-create-actions"><button type="button" class="twbv-item-create twbv-item-create--fancy twbv-trait-create twbv-trait-create--power" data-type="poder" data-label="Poder" data-dialog-version="2"><i class="fas fa-plus"></i> Poder</button></div></div>
          <div class="twbv-item-card-list">
            {{#each poderes as |item|}}
              <article class="twbv-item-card twbv-item-card--fantasy twbv-item-card--collapsible is-collapsed" data-item-id="{{item.id}}" data-item-uuid="{{item.uuid}}" data-item-type="{{item.type}}" draggable="true">
                <div class="twbv-item-card-layout">
                  <div class="twbv-item-card-icon">{{#if item.icon}}<img src="{{item.icon}}" alt="{{item.name}}" />{{else}}<i class="fas fa-wand-magic-sparkles"></i>{{/if}}</div>
                  <div class="twbv-item-card-content">
                    <div class="twbv-item-card-head twbv-item-card-head--toggle"><h3>{{item.name}}</h3><div class="twbv-item-card-actions"><button type="button" class="twbv-item-edit" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}" data-type="poder"><i class="fas fa-edit"></i></button><button type="button" class="twbv-item-delete" data-item-id="{{item.id}}" data-source-type="{{item.sourceType}}" data-list-key="{{item.listKey}}"><i class="fas fa-trash"></i></button></div></div>
                    <div class="twbv-item-card-meta">{{#if item.skill}}Pericia: {{item.skill}}{{else}}Pericia: -{{/if}} &middot; Mana: {{item.manaCost}}{{#if item.damage}} &middot; Dano: {{item.damage}}{{/if}}{{#if item.areaEffectLabel}} &middot; Area: {{item.areaEffectLabel}}{{/if}}{{#if item.categoria}} &middot; Categoria: {{item.categoria}}{{/if}}</div>
                    <p class="twbv-item-effect">{{#if item.descricao}}{{item.descricao}}{{else}}Sem descricao.{{/if}}</p>
                  </div>
                </div>
              </article>
            {{else}}<p class="twbv-adv-empty twbv-trait-empty">Nenhum poder cadastrado.</p>{{/each}}
          </div>
        </div>
      </div>
    </div>
    <div class="tab" data-group="primary" data-tab="historia"><div class="twbv-panel twbv-ornate"><h2>História</h2><p>Em construção.</p></div></div>
    <div class="tab" data-group="primary" data-tab="avancos">
      <section class="twbv-panel twbv-ornate">
        <div class="twbv-adv-header">
          <h2>Avanços</h2>
          <button type="button" class="twbv-add-advancement"><i class="fas fa-plus"></i> Adicionar avanço</button>
        </div>
        <label>Avanços totais
          <input type="number" name="system.avancosTotais" value="{{system.avancosTotais}}" min="0" />
        </label>
        <label>Estágio atual
          <input type="text" value="{{stageName}}" disabled />
        </label>
        <div class="twbv-stages-grid">
          {{#each stages as |stage|}}
            <div class="twbv-stage-chip {{#if stage.current}}is-current{{/if}}">
              <span class="twbv-stage-name">{{stage.name}}</span>
              <span class="twbv-stage-range">{{stage.range}}</span>
            </div>
          {{/each}}
        </div>
        <div class="twbv-adv-list">
          {{#if system.avancos.length}}
            {{#each advancementGroups as |group|}}
              <section class="twbv-adv-tier-group" data-tier="{{group.key}}">
                <header class="twbv-adv-tier-header">
                  <span class="twbv-adv-tier-badge">{{group.name}}</span>
                </header>
                <div class="twbv-adv-tier-cards">
                  {{#each group.entries as |avanco|}}
                    <article class="twbv-adv-entry">
                      <button type="button" class="twbv-remove-advancement" data-index="{{avanco.sourceIndex}}" title="Remover avanço"><i class="fas fa-trash"></i></button>
                      <h3>Avanço {{avanco.numero}} — {{#if avanco.tipo}}{{avanco.tipo}}{{else}}Outro{{/if}}</h3>
                      <p class="twbv-adv-entry-description">{{#if avanco.descricao}}{{avanco.descricao}}{{else}}Sem descrição.{{/if}}</p>
                    </article>
                  {{/each}}
                </div>
              </section>
            {{/each}}
          {{else}}
            <p class="twbv-adv-empty">Nenhum avanço registrado ainda.</p>
          {{/if}}
        </div>
      </section>
    </div>
    <div class="tab" data-group="primary" data-tab="efeitos"><div class="twbv-panel twbv-ornate"><h2>Efeitos</h2><p>Em construção.</p></div></div>
  </section>
</form>
